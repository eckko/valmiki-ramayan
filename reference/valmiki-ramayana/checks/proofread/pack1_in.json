  "kind": "typo?",
  "line": "कैलासं लङ्घयित्वाथ दशग्रीवः सराक्षसः",
  "before": "नारीषु मैथुनं भावं नाकामास्वभ्यरोचयत्",
  "after": "आससाद महातेजा इन्द्रलोकं निशाचरः",
  "note": "सराक्षसः (1x) is close to राक्षसः (78x)"
 },
 {
  "id": "05.035.64a",
  "kind": "typo?",
  "line": "यदि रामो दशग्रीवमिह हत्वा सराक्षसं",
  "before": "अनीशा किं करिष्यामि विनाथा विवशा सती",
  "after": "मामितो गृह्य गच्छेत तत्तस्य सदृशं भवेत्",
  "note": "सराक्षसं (1x) is close to राक्षसं (76x)"
 },
 {
  "id": "04.016.24b",
  "kind": "typo?",
  "line": "वालिनं प्रति सामर्षो दर्शयामास लाघवम्",
  "before": "वालिना भग्नदर्पस्तु सुग्रीवो मन्दविक्रमः",
  "after": "ततो धनुषि सन्धाय शरमाशीविषोपमम्",
  "note": "लाघवम् (1x) is close to राघवम् (72x)"
 },
 {
  "id": "06.081.20a",
  "kind": "typo?",
  "line": "प्रहरन्तं शरीरेषु न ते पश्यन्ति राभवम्",
  "before": "बलं रामेण ददृशुर्न रमं शीघ्रकारिणम्",
  "after": "इन्द्रियार्थेषु तिष्ठन्तं भूतात्मानमिव प्रजाः",
  "note": "राभवम् (1x) is close to राघवम् (72x)"
 },
 {
  "id": "02.090.12a",
  "kind": "typo?",
  "line": "एवमुक्क्तस्तु रामेण लक्ष्माणो वाक्यमब्रवीत्",
  "before": "अङ्गावेक्षस्व सौमित्रे कस्यैतां मन्यसे चमूम्",
  "after": "दिधक्षन्निव तां सेनां रुषितः पावको यथा",
