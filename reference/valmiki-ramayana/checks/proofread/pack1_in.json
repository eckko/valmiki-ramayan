 },
 {
  "id": "03.064.5a",
  "kind": "typo?",
  "line": "किन्निमित्तोऽहरत्सीतां रावणस्तस्य किं मया",
  "before": "सीतामाख्याहि भद्रं ते वधमाख्याहि चात्मनः",
  "after": "अपराद्धं तु यं दृष्ट्वा रावणेन हृता प्रिया",
  "note": "रावणस्तस्य (2x) is close to रावणस्य (128x)"
 },
 {
  "id": "07.061.15a",
  "kind": "typo?",
  "line": "नापि शूलं प्रजग्राह तं दृष्ट्वा भुवि पातितम्",
  "before": "रक्षो लब्धान्तरमपि न विवेश स्वमालयम्",
  "after": "ततो हत इति ज्ञात्वा तान् भक्षान् समुदावहत्",
