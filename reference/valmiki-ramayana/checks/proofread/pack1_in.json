 },
 {
  "id": "02.052.20a",
  "kind": "typo?",
  "line": "असमीक्ष्य समारब्धं विरुद्धं बुद्धिलाघवात्",
  "before": "रामस्य तु परित्यागे न हेतुमुपलक्षये",
  "after": "जनयिष्यति सङ्क्रोशं राघवस्य विवासनम्",
