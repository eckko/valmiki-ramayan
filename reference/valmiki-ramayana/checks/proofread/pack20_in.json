[
 {
  "id": "07.003.31a",
  "kind": "metre",
  "line": "स देवगन्धर्वगणैरभिष्टुतस्॑ तथैव सिद्धैः सह चारणैरपि",
  "before": "अभ्यगच्छत्सुसंहृष्टः पितरं मातरं च सः",
  "after": "गभस्तिभिः सूर्य इवौजसा वृतः॑ पितुः समीपं प्रययौ श्रिया वृतः",
  "note": "24 aksharas"
 },
 {
  "id": "07.003.31b",
  "kind": "metre",
  "line": "गभस्तिभिः सूर्य इवौजसा वृतः॑ पितुः समीपं प्रययौ श्रिया वृतः",
  "before": "स देवगन्धर्वगणैरभिष्टुतस्॑ तथैव सिद्धैः सह चारणैरपि",
  "after": "श्रुत्वागस्त्येरितं वाक्यं रामो विस्मयमागतः",
  "note": "24 aksharas"
 },
 {
  "id": "07.004.31a",
  "kind": "metre",
  "line": "ततः सुकेशो वरदानगर्वितः॑ श्रियं प्रभोः प्राप्य हरस्य पार्श्वतः",
  "before": "सद्य एव वयःप्राप्तिर्मातुरेव वयः समम्",
  "after": "चचार सर्वत्र महामतिः खगः॑ खगं पुरं प्राप्य पुरन्दरो यथा",
  "note": "24 aksharas"
 },
 {
  "id": "07.004.31b",
  "kind": "metre",
  "line": "चचार सर्वत्र महामतिः खगः॑ खगं पुरं प्राप्य पुरन्दरो यथा",
  "before": "ततः सुकेशो वरदानगर्वितः॑ श्रियं प्रभोः प्राप्य हरस्य पार्श्वतः",
  "after": "सुकेशं धार्मिकं दृष्ट्वा वरलब्धं च राक्षसं",
  "note": "24 aksharas"
 },
 {
  "id": "07.005.40a",
  "kind": "metre",
  "line": "ततस्तु ते राक्षसपुङ्गवास्त्रयो॑ निशाचरैः पुत्रशतैश्च संवृताः",
  "before": "एते विभीषणामात्या मालेयास्ते निशाचराः",
  "after": "सुरान् सहेन्द्रानृषिनागदानवान्॑ बबाधिरे ते बलवीर्यदर्पिताः",
  "note": "24 aksharas"
 },
 {
  "id": "07.005.40b",
  "kind": "metre",
  "line": "सुरान् सहेन्द्रानृषिनागदानवान्॑ बबाधिरे ते बलवीर्यदर्पिताः",
  "before": "ततस्तु ते राक्षसपुङ्गवास्त्रयो॑ निशाचरैः पुत्रशतैश्च संवृताः",
  "after": "जगद्भ्रमन्तोऽनिलवद्दुरासदा॑ रणे च मृत्युप्रतिमाः समाहिताः",
  "note": "24 aksharas"
 },
 {
  "id": "07.005.41a",
  "kind": "metre",
  "line": "जगद्भ्रमन्तोऽनिलवद्दुरासदा॑ रणे च मृत्युप्रतिमाः समाहिताः",
  "before": "सुरान् सहेन्द्रानृषिनागदानवान्॑ बबाधिरे ते बलवीर्यदर्पिताः",
  "after": "वरप्रदानादभिगर्विता भृशं॑ क्रतुक्रियाणां प्रशमङ्कराः सदा",
  "note": "24 aksharas"
 },
 {
  "id": "07.005.41b",
  "kind": "metre",
  "line": "वरप्रदानादभिगर्विता भृशं॑ क्रतुक्रियाणां प्रशमङ्कराः सदा",
  "before": "जगद्भ्रमन्तोऽनिलवद्दुरासदा॑ रणे च मृत्युप्रतिमाः समाहिताः",
  "after": "तैर्वध्यमाना देवाश्च ऋषयश्च तपोधनाः",
  "note": "24 aksharas"
 },
 {
  "id": "07.006.55a",
  "kind": "metre",
  "line": "तथ शितैः शोणितमांसरूषितैर्॑ युगान्तवैश्वानरतुल्यविग्रहैः",
  "before": "चचाल तद्राक्षसराजसैन्यं॑ चलोपलो नील इवाचलेन्द्रः",
  "after": "निशाचराः सम्परिवार्य माधवं॑ वरायुधैर्निर्बिभिदुः सहस्रशः",
  "note": "24 aksharas"
 },
 {
  "id": "07.006.55b",
  "kind": "metre",
  "line": "निशाचराः सम्परिवार्य माधवं॑ वरायुधैर्निर्बिभिदुः सहस्रशः",
  "before": "तथ शितैः शोणितमांसरूषितैर्॑ युगान्तवैश्वानरतुल्यविग्रहैः",
  "after": "नारायणगिरिं ते तु गर्जन्तो राक्षसाम्बुदाः",
  "note": "24 aksharas"
 },
 {
  "id": "07.007.50a",
  "kind": "metre",
  "line": "तदाम्बरं विगलितहारकुण्डलैर्॑ निशाचरैर्नीलबलाहकोपमैः",
  "before": "निपेतुरम्बरात्तूर्णं राक्षसाः सागराम्भसि",
  "after": "निपात्यमानैर्ददृशे निरन्तरं॑ निपात्यमानैरिव नीलपर्वतैः",
  "note": "25 aksharas"
 },
 {
  "id": "07.007.50b",
  "kind": "metre",
  "line": "निपात्यमानैर्ददृशे निरन्तरं॑ निपात्यमानैरिव नीलपर्वतैः",
  "before": "तदाम्बरं विगलितहारकुण्डलैर्॑ निशाचरैर्नीलबलाहकोपमैः",
  "after": "हन्यमाने बले तस्मिन् पद्मनाभेन पृष्ठतः",
  "note": "24 aksharas"
 },
 {
  "id": "07.011.40a",
  "kind": "metre",
  "line": "स चाभिषिक्तः क्षणदाचरैस्तदा॑ निवेशयामास पुरीं दशाननः",
  "before": "विवेश नगरीं लङ्कां सभ्राता सबलानुगः",
  "after": "निकामपूर्णा च बभूव सा पुरी॑ निशाचरैर्नीलबलाहकोपमैः",
  "note": "24 aksharas"
 },
 {
  "id": "07.011.40b",
  "kind": "metre",
  "line": "निकामपूर्णा च बभूव सा पुरी॑ निशाचरैर्नीलबलाहकोपमैः",
  "before": "स चाभिषिक्तः क्षणदाचरैस्तदा॑ निवेशयामास पुरीं दशाननः",
  "after": "धनेश्वरस्त्वथ पितृवाक्यगौरवान्॑ न्यवेशयच्छशिविमले गिरौ",
  "note": "24 aksharas"
 },
 {
  "id": "07.011.41a",
  "kind": "metre",
  "line": "धनेश्वरस्त्वथ पितृवाक्यगौरवान्॑ न्यवेशयच्छशिविमले गिरौ",
  "before": "निकामपूर्णा च बभूव सा पुरी॑ निशाचरैर्नीलबलाहकोपमैः",
  "after": "पुरीम्",
  "note": "24 aksharas"
 },
 {
  "id": "07.011.41b",
  "kind": "metre",
  "line": "पुरीम्",
  "before": "धनेश्वरस्त्वथ पितृवाक्यगौरवान्॑ न्यवेशयच्छशिविमले गिरौ",
  "after": "स्वलङ्कृतैर्भवनवरैर्विभूषितां॑ पुरन्दरस्येव तदामरावतीम्",
  "note": "2 aksharas"
 },
 {
  "id": "07.011.41c",
  "kind": "metre",
  "line": "स्वलङ्कृतैर्भवनवरैर्विभूषितां॑ पुरन्दरस्येव तदामरावतीम्",
  "before": "पुरीम्",
  "after": "राक्षसेन्द्रोऽभिषिक्तस्तु भ्रातृभ्यां सहितस्तदा",
  "note": "25 aksharas"
 },
 {
  "id": "07.029.37b",
  "kind": "metre",
  "line": "भवनमभि ततो जगाम हृष्टः॑ स्वसुतमवाप्य च वाक्यमब्रवीत्",
  "before": "अथ रणविगतज्वरः प्रभुर्॑ विजयमवाप्य निशाचराधिपः",
  "after": "अतिबलसदृशैः पराक्रमैस्तैर्॑ मम कुलमानविवर्धनं कृतम्",
  "note": "24 aksharas"
 },
 {
  "id": "07.029.38a",
  "kind": "metre",
  "line": "अतिबलसदृशैः पराक्रमैस्तैर्॑ मम कुलमानविवर्धनं कृतम्",
  "before": "भवनमभि ततो जगाम हृष्टः॑ स्वसुतमवाप्य च वाक्यमब्रवीत्",
  "after": "यदमरसमविक्रम त्वया॑ त्रिदशपतिस्त्रिदशाश्च निर्जिताः",
  "note": "24 aksharas"
 },
 {
  "id": "07.031.40a",
  "kind": "metre",
  "line": "ततः सतामार्तिहरं हरं परं॑ वरप्रदं चन्द्रमयूखभूषणम्",
  "before": "अर्चयामास गन्धैश्च पुष्पैश्चामृतगन्धिभिः",
  "after": "समर्चयित्वा स निशाचरो जगौ॑ प्रसार्य हस्तान् प्रणनर्त चायतान्",
  "note": "24 aksharas"
 },
 {
  "id": "07.031.40b",
  "kind": "metre",
  "line": "समर्चयित्वा स निशाचरो जगौ॑ प्रसार्य हस्तान् प्रणनर्त चायतान्",
  "before": "ततः सतामार्तिहरं हरं परं॑ वरप्रदं चन्द्रमयूखभूषणम्",
  "after": "नर्मदा पुलिने यत्र राक्षसेन्द्रः स रावणः",
  "note": "24 aksharas"
 },
 {
  "id": "07.032.72a",
  "kind": "metre",
  "line": "स कीर्यमाणः कुसुमाक्षतोत्करैर्॑ द्विजैः सपौरैः पुरुहूतसन्निभः",
  "before": "रावणं गृह्य नगरं प्रविवेश सुहृद्वृतः",
  "after": "तदार्जुनः सम्प्रविवेश तां पुरीं॑ बलिं निगृह्यैव सहस्रलोचनः",
  "note": "24 aksharas"
 },
 {
  "id": "07.032.72b",
  "kind": "metre",
  "line": "तदार्जुनः सम्प्रविवेश तां पुरीं॑ बलिं निगृह्यैव सहस्रलोचनः",
  "before": "स कीर्यमाणः कुसुमाक्षतोत्करैर्॑ द्विजैः सपौरैः पुरुहूतसन्निभः",
  "after": "रावणग्रहणं तत्तु वायुग्रहणसन्निभम्",
  "note": "24 aksharas"
 },
 {
  "id": "07.033.18a",
  "kind": "metre",
  "line": "स तं प्रमुक्त्वा त्रिदशारिमर्जुनः॑ प्रपूज्य दिव्याभरणस्रगम्बरैः",
  "before": "मुमोच पार्थिवेन्द्रेन्द्रो राक्षसेन्द्रं प्रहृष्टवत्",
  "after": "अहिंसाकं सख्यमुपेत्य साग्निकं॑ प्रणम्य स ब्रह्मसुतं गृहं ययौ",
  "note": "24 aksharas"
 },
 {
  "id": "07.033.18b",
  "kind": "metre",
  "line": "अहिंसाकं सख्यमुपेत्य साग्निकं॑ प्रणम्य स ब्रह्मसुतं गृहं ययौ",
  "before": "स तं प्रमुक्त्वा त्रिदशारिमर्जुनः॑ प्रपूज्य दिव्याभरणस्रगम्बरैः",
  "after": "पुलस्त्येनापि सङ्गम्य राक्षसेन्द्रः प्रतापवान्",
  "note": "24 aksharas"
 },
 {
  "id": "07.035.64a",
  "kind": "metre",
  "line": "ततः प्रजाभिः सहितः प्रजापतिः॑ सदेवगन्धर्वभुजङ्गगुह्यकः",
  "before": "मा विनाशं गमिष्याम अप्रसाद्यादितेः सुतम्",
  "after": "जगाम तत्रास्यति यत्र मारुतः॑ सुतं सुरेन्द्राभिहतं प्रगृह्य सः",
  "note": "24 aksharas"
 },
 {
  "id": "07.035.64b",
  "kind": "metre",
  "line": "जगाम तत्रास्यति यत्र मारुतः॑ सुतं सुरेन्द्राभिहतं प्रगृह्य सः",
  "before": "ततः प्रजाभिः सहितः प्रजापतिः॑ सदेवगन्धर्वभुजङ्गगुह्यकः",
  "after": "ततोऽर्कवैश्वानरकाञ्चनप्रभं॑ सुतं तदोत्सङ्गगतं सदा गतेः",
  "note": "24 aksharas"
 },
 {
  "id": "07.035.65a",
  "kind": "metre",
  "line": "ततोऽर्कवैश्वानरकाञ्चनप्रभं॑ सुतं तदोत्सङ्गगतं सदा गतेः",
  "before": "जगाम तत्रास्यति यत्र मारुतः॑ सुतं सुरेन्द्राभिहतं प्रगृह्य सः",
  "after": "चतुर्मुखो वीक्ष्य कृपामथाकरोत्॑ सदेवसिद्धर्षिभुजङ्गराक्षसः",
  "note": "24 aksharas"
 },
 {
  "id": "07.035.65b",
  "kind": "metre",
  "line": "चतुर्मुखो वीक्ष्य कृपामथाकरोत्॑ सदेवसिद्धर्षिभुजङ्गराक्षसः",
  "before": "ततोऽर्कवैश्वानरकाञ्चनप्रभं॑ सुतं तदोत्सङ्गगतं सदा गतेः",
  "after": "ततः पितामहं दृष्ट्वा वायुः पुत्रवधार्दितः",
  "note": "24 aksharas"
 },
 {
  "id": "07.047.18a",
  "kind": "metre",
  "line": "सा दुःखभारावनता तपस्विनी॑ यशोधरा नाथमपश्यती सती",
  "before": "निरीक्षमाणामुद्विग्नां सीतां शोकः समाविशत्",
  "after": "रुरोद सा बर्हिणनादिते वने॑ महास्वनं दुःखपरायणा सती",
  "note": "24 aksharas"
 },
 {
  "id": "07.047.18b",
  "kind": "metre",
  "line": "रुरोद सा बर्हिणनादिते वने॑ महास्वनं दुःखपरायणा सती",
  "before": "सा दुःखभारावनता तपस्विनी॑ यशोधरा नाथमपश्यती सती",
  "after": "सीतां तु रुदतीं दृष्ट्वा ये तत्र मुनिदारकाः",
  "note": "24 aksharas"
 },
 {
  "id": "07.052.16a",
  "kind": "metre",
  "line": "त्वया पुनर्ब्राह्मण गौरवादियं॑ कृत्वा प्रतिज्ञा ह्यनवेक्ष्य कारणम्",
  "before": "कार्यगौरवमश्रुत्वा प्रतिज्ञां नाभ्यरोचयन्",
  "after": "कुरुष्व कर्ता ह्यसि नात्र संशयो॑ महाभयात्त्रातुमृषींस्त्वमर्हसि",
  "note": "24 aksharas"
 },
 {
  "id": "07.052.16b",
  "kind": "metre",
  "line": "कुरुष्व कर्ता ह्यसि नात्र संशयो॑ महाभयात्त्रातुमृषींस्त्वमर्हसि",
  "before": "त्वया पुनर्ब्राह्मण गौरवादियं॑ कृत्वा प्रतिज्ञा ह्यनवेक्ष्य कारणम्",
  "after": "ब्रुवद्भिरेवमृषिभिः काकुत्स्थो वाक्यमब्रवीत्",
  "note": "24 aksharas"
 },
 {
  "id": "07.084.16b",
  "kind": "metre",
  "line": "समुत्सुकौ तौ सुखमूषतुर्निशां॑ यथाश्विनौ भार्गवनीतिसंस्कृतौ",
  "before": "तामद्भुतां तौ हृदये कुमारौ॑ निवेश्य वाणीमृषिभाषितां शुभाम्",
  "after": "तौ रजन्यां प्रभातायां स्नातौ हुतहुताशनौ",
  "note": "24 aksharas"
 },
 {
  "id": "07.092.17a",
  "kind": "metre",
  "line": "विहृत्य लाकं परिपूर्णमानसाः॑ श्रिया वृता धर्मपथे परे स्थिताः",
  "before": "धर्मे प्रयतमानानां पौरकार्येषु नित्यदा",
  "after": "त्रयः समिद्धा इव दीप्ततेजसा॑ हुताग्नयः साधु महाध्वरे त्रयः",
  "note": "24 aksharas"
 },
 {
  "id": "07.092.17b",
  "kind": "metre",
  "line": "त्रयः समिद्धा इव दीप्ततेजसा॑ हुताग्नयः साधु महाध्वरे त्रयः",
  "before": "विहृत्य लाकं परिपूर्णमानसाः॑ श्रिया वृता धर्मपथे परे स्थिताः",
  "after": "कस्य चित्त्वथ कालस्य रामे धर्मपथे स्थिते",
  "note": "24 aksharas"
 },
 {
  "id": "01.002.7a",
  "kind": "sample",
  "line": "एवमुक्तो भरद्वाजो वाल्मीकेन महात्मना",
  "before": "इदमेवावगाहिष्ये तमसातीर्थमुत्तमम्",
  "after": "प्रायच्छत मुनेस्तस्य वल्कलं नियतो गुरोः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.003.5a",
  "kind": "sample",
  "line": "रामरामविवादं च गुणान् दाशरथेस्तथा",
  "before": "जानक्याश्च विवाहं च धनुषश्च विभेदनम्",
  "after": "तथाभिषेकं रामस्य कैकेय्या दुष्टभावताम्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.008.14a",
  "kind": "sample",
  "line": "भवन्तः श्रुतधर्माणो लोके चारित्रवेदिनः",
  "before": "ब्राह्मणाञ्श्रुतवृद्धांश्च समानीय प्रवक्ष्यति",
  "after": "समादिशन्तु नियमं प्रायश्चित्तं यथा भवेत्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.008.20a",
  "kind": "sample",
  "line": "वक्ष्यन्ति चिन्तयित्वा ते तस्योपायांश्च तान् क्षमान्",
  "before": "न गच्छेम ऋषेर्भीता अनुनेष्यन्ति तं नृपम्",
  "after": "आनेष्यामो वयं विप्रं न च दोषो भविष्यति",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.009.26a",
  "kind": "sample",
  "line": "एह्याश्रमपदं सौम्य अस्माकमिति चाब्रुवन्",
  "before": "उपसृत्य ततः सर्वास्तास्तमूचुरिदं वचः",
  "after": "तत्राप्येष विधिः श्रीमान् विशेषेण भविष्यति",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.011.3b",
  "kind": "sample",
  "line": "सम्भाराः सम्भ्रियन्तां ते तुरगश्च विमुच्यताम्",
  "before": "तथेति च स राजानमुवाच च सुसत्कृतः",
  "after": "ततो राजाब्रवीद्वाक्यं सुमन्त्रं मन्त्रिसत्तमम्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.011.9b",
  "kind": "sample",
  "line": "ऋषिपुत्रप्रभावेन कामान् प्राप्स्यामि चाप्यहम्",
  "before": "तदहं यष्टुमिच्छामि शास्त्रदृष्टेन कर्मणा",
  "after": "ततः साध्विति तद्वाक्यं ब्राह्मणाः प्रत्यपूजयन्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.013.13b",
  "kind": "sample",
  "line": "उपासते च तानन्ये सुमृष्टमणिकुण्डलाः",
  "before": "स्वलङ्कृताश्च पुरुषा ब्राह्मणान् पर्यवेषयन्",
  "after": "कर्मान्तरे तदा विप्रा हेतुवादान् बहूनपि",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.013.22a",
  "kind": "sample",
  "line": "इष्टकाश्च यथान्यायं कारिताश्च प्रमाणतः",
  "before": "सप्तर्षयो दीप्तिमन्तो विराजन्ते यथा दिवि",
  "after": "चितोऽग्निर्ब्राह्मणैस्तत्र कुशलैः शुल्बकर्मणि",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.013.31a",
  "kind": "sample",
  "line": "हयस्य यानि चाङ्गानि तानि सर्वाणि ब्राह्मणाः",
  "before": "यथाकालं यथान्यायं निर्णुदन् पापमात्मनः",
  "after": "अग्नौ प्रास्यन्ति विधिवत्समस्ताः षोडशर्त्विजः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.015.4b",
  "kind": "sample",
  "line": "येन तुष्टोऽभवद्ब्रह्मा लोककृल्लोकपूजितः",
  "before": "स हि तेपे तपस्तीव्रं दीर्घकालमरिन्दम",
  "after": "सन्तुष्टः प्रददौ तस्मै राक्षसाय वरं प्रभुः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.015.27b",
  "kind": "sample",
  "line": "एवं तासां ददौ राजा भार्याणां पायसं पृथक्",
  "before": "अनुचिन्त्य सुमित्रायै पुनरेव महीपतिः",
  "after": "तास्त्वेतत्पायसं प्राप्य नरेन्द्रस्योत्तमाः स्त्रियः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.020.8b",
  "kind": "sample",
  "line": "इष्टापूर्तवधो भूयात्तस्माद्रामं विसर्जय",
  "before": "संश्रुत्यैवं करिष्यामीत्यकुर्वाणस्य राघव",
  "after": "कृतास्त्रमकृतास्त्रं वा नैनं शक्ष्यन्ति राक्षसाः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.022.17b",
  "kind": "sample",
  "line": "विज्ञाय परमप्रीता मुनयो हर्षमागमन्",
  "before": "तेषां संवदतां तत्र तपो दीर्घेण चक्षुषा",
  "after": "अर्घ्यं पाद्यं तथातिथ्यं निवेद्यकुशिकात्मजे",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.023.6b",
  "kind": "sample",
  "line": "कथयामास धर्मात्मा तस्य शब्दस्य निश्चयम्",
  "before": "राघवस्य वचः श्रुत्वा कौतूहल समन्वितम्",
  "after": "कैलासपर्वते राम मनसा निर्मितं सरः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.023.25b",
  "kind": "sample",
  "line": "मारीचो राक्षसः पुत्रो यस्याः शक्रपराक्रमः",
  "before": "ताटका नाम भद्रं ते भार्या सुन्दस्य धीमतः",
  "after": "इमौ जनपदौ नित्यं विनाशयति राघव",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.027.3a",
  "kind": "sample",
  "line": "एवं ब्रुवति काकुत्स्थे विश्वामित्रो महामुनिः",
  "before": "अस्त्राणां त्वहमिच्छामि संहारं मुनिपुङ्गव",
  "after": "संहारं व्याजहाराथ धृतिमान् सुव्रतः शुचिः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.032.4a",
  "kind": "sample",
  "line": "तेन पापानुबन्धेन वचनं न प्रतीच्छता",
  "before": "पितरं नो वृणीष्व त्वं यदि नो दास्यते तव",
  "after": "एवं ब्रुवन्त्यः सर्वाः स्म वायुना निहता भृषम्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.037.10a",
  "kind": "sample",
  "line": "एकः कस्याः सुतो ब्रह्मन् का बहूञ्जनयिष्यति",
  "before": "ऊचतुः परमप्रीते कृताञ्जलिपुटे तदा",
  "after": "श्रोतुमिच्छावहे ब्रह्मन् सत्यमस्तु वचस्तव",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.041.22a",
  "kind": "sample",
  "line": "इयं हैमवती गङ्गा ज्येष्ठा हिमवतः सुता",
  "before": "एवं भवतु भद्रं ते इक्ष्वाकुकुलवर्धन",
  "after": "तां वै धारयितुं राजन् हरस्तत्र नियुज्यताम्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.049.14b",
  "kind": "sample",
  "line": "यज्ञोपसदनं ब्रह्मन् प्राप्तोऽसि मुनिभिः सह",
  "before": "धन्योऽस्म्यनुगृहीतोऽस्मि यस्य मे मुनिपुङ्गव",
  "after": "द्वादशाहं तु ब्रह्मर्षे शेषमाहुर्मनीषिणः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.054.6a",
  "kind": "sample",
  "line": "अभ्यधावत्सुसङ्क्रुद्धं वसिष्ठं जपतां वरम्",
  "before": "विश्वामित्रसुतानां तु शतं नानाविधायुधम्",
  "after": "हुङ्कारेणैव तान् सर्वान्निर्ददाह महानृषिः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.057.19a",
  "kind": "sample",
  "line": "यज्ञैर्बहुविधैरिष्टं प्रजा धर्मेण पालिताः",
  "before": "कृच्छ्रेष्वपि गतः सौम्य क्षत्रधर्मेण ते शपे",
  "after": "गुरवश्च महात्मानः शीलवृत्तेन तोषिताः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.068.2a",
  "kind": "sample",
  "line": "अद्य सर्वे धनाध्यक्षा धनमादाय पुष्कलम्",
  "before": "राजा दशरथो हृष्टः सुमन्त्रमिदमब्रवीत्",
  "after": "व्रजन्त्वग्रे सुविहिता नानारत्नसमन्विताः",
  "note": "ordinary line, no flag"
 }
]