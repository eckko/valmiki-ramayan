[
 {
  "id": "01.069.18b",
  "kind": "sample",
  "line": "मनुः प्रजापतिः पूर्वमिक्ष्वाकुस्तु मनोः सुतः",
  "before": "विवस्वान् कश्यपाज्जज्ञे मनुर्वैवैवतः स्मृतः",
  "after": "तमिक्ष्वाकुमयोध्यायां राजानं विद्धि पूर्वकम्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.071.2b",
  "kind": "sample",
  "line": "इक्ष्वाकूणां विदेहानां नैषां तुल्योऽस्ति कश्चन",
  "before": "अचिन्त्यान्यप्रमेयानि कुलानि नरपुङ्गव",
  "after": "सदृशो धर्मसम्बन्धः सदृशो रूपसम्पदा",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.076.6a",
  "kind": "sample",
  "line": "पताकाध्वजिनीं रम्यां तूर्योद्घुष्टनिनादिताम्",
  "before": "चोदयामास तां सेनां जगामाशु ततः पुरीम्",
  "after": "सिक्तराजपथां रम्यां प्रकीर्णकुसुमोत्कराम्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "02.002.18b",
  "kind": "sample",
  "line": "बहवो नृप कल्याणा गुणाः पुत्रस्य सन्ति ते",
  "before": "ते तमूचुर्महात्मानं पौरजानपदैः सह",
  "after": "दिव्यैर्गुणैः शक्रसमो रामः सत्यपराक्रमः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "02.004.2b",
  "kind": "sample",
  "line": "रामो राजीवताम्राक्षो यौवराज्य इति प्रभुः",
  "before": "श्व एव पुष्यो भविता श्वोऽभिषेच्येत मे सुतः",
  "after": "अथान्तर्गृहमाविश्य राजा दशरथस्तदा",
  "note": "ordinary line, no flag"
 },
 {
  "id": "02.006.15b",
  "kind": "sample",
  "line": "रामाभिषेके सम्प्राप्ते चत्वरेषु गृहेषु च",
  "before": "रामाभिषेकयुक्ताश्च कथाश्चक्रुर्मिथो जनाः",
  "after": "बाला अपि क्रीडमाना गृहद्वारेषु सङ्घशः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "02.007.6b",
  "kind": "sample",
  "line": "आचचक्षेऽथ कुब्जायै भूयसीं राघवे श्रियम्",
  "before": "विदीर्यमाणा हर्षेण धात्री परमया मुदा",
  "after": "श्वः पुष्येण जितक्रोधं यौवराज्येन राघवम्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "02.009.40b",
  "kind": "sample",
  "line": "शयानां शयने शुभ्रे वेद्यामग्निशिखामिव",
  "before": "इति प्रशस्यमाना सा कैकेयीमिदमब्रवीत्",
  "after": "गतोदके सेतुबन्धो न कल्याणि विधीयते",
  "note": "ordinary line, no flag"
 },
 {
  "id": "02.010.7b",
  "kind": "sample",
  "line": "भूमौ शेषे किमर्थं त्वं मयि कल्याण चेतसि",
  "before": "यदिदं मम दुःखाय शेषे कल्याणि पांसुषु",
  "after": "भूतोपहतचित्तेव मम चित्तप्रमाथिनी",
  "note": "ordinary line, no flag"
 },
 {
  "id": "02.011.11a",
  "kind": "sample",
  "line": "एवमुक्त्वा ततो राजा कैकेयीं संयताञ्जलिः",
  "before": "नृशंसां कैकेयीं द्रष्टुं यत्कृते व्यसनं महत्",
  "after": "प्रसादयामास पुनः कैकेयीं चेदमब्रवीत्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "02.016.38b",
  "kind": "sample",
  "line": "प्रस्थानं श्रद्दधाना हि त्वरयामास राघवम्",
  "before": "सा हृष्टा तस्य तद्वाक्यं श्रुत्वा रामस्य कैकयी",
  "after": "एवं भवतु यास्यन्ति दूताः शीघ्रजवैर्हयैः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "02.021.25b",
  "kind": "sample",
  "line": "उवाच रामं शुभलक्षणं वचो॑ बभूव च स्वस्त्ययनाभिकाङ्क्षिणी",
  "before": "तथा हि रामं वनवासनिश्चितं॑ समीक्ष्य देवी परमेण चेतसा",
  "after": "सापनीय तमायासमुपस्पृश्य जलं शुचि",
  "note": "ordinary line, no flag"
 },
 {
  "id": "02.026.4b",
  "kind": "sample",
  "line": "सुराणामीश्वरः शक्रः प्रधर्षयितुमोजसा",
  "before": "न च मां त्वत्समीपस्थमपि शक्नोति राघव",
  "after": "पतिहीना तु या नारी न सा शक्ष्यति जीवितुम्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "02.034.3a",
  "kind": "sample",
  "line": "स मुहूर्तमिवासञ्ज्ञो दुःखितश्च महीपतिः",
  "before": "न चैनमभिसम्प्रेक्ष्य प्रत्यभाषत दुर्मनाः",
  "after": "विललाप महाबाहू राममेवानुचिन्तयन्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "02.035.36a",
  "kind": "sample",
  "line": "न्यवर्तत जनो राज्ञो रामं कृत्वा प्रदक्षिणम्",
  "before": "व्रजतोऽपि हयाञ्शीघ्रं चोदयामास सारथिः",
  "after": "मनसाप्यश्रुवेगैश्च न न्यवर्तत मानुषम्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "02.037.14b",
  "kind": "sample",
  "line": "पदानि पथि दृश्यन्ते स महात्मा न दृश्यते",
  "before": "वाहनानां च मुख्यानां वहतां तं ममात्मजम्",
  "after": "स नूनं क्व चिदेवाद्य वृक्षमूलमुपाश्रितः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "02.037.21a",
  "kind": "sample",
  "line": "तामवेक्ष्य पुरीं सर्वां राममेवानुचिन्तयन्",
  "before": "क्लान्तदुर्बलदुःखार्तां नात्याकीर्णमहापथाम्",
  "after": "विलपन् प्राविशद्राजा गृहं सूर्य इवाम्बुदम्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "02.041.25b",
  "kind": "sample",
  "line": "यथा न विद्युः पौरा मां तथा कुरु समाहितः",
  "before": "मुहूर्तं त्वरितं गत्वा निर्गतय रथं पुनः",
  "after": "रामस्य वचनं श्रुत्वा तथा चक्रे स सारथिः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "02.042.16a",
  "kind": "sample",
  "line": "युष्माकं राघवोऽरण्ये योगक्षेमं विधास्यति",
  "before": "इति पौरस्त्रियो भर्तॄन् दुःखार्तास्तत्तदब्रुवन्",
  "after": "सीता नारीजनस्यास्य योगक्षेमं करिष्यति",
  "note": "ordinary line, no flag"
 },
 {
  "id": "02.046.6a",
  "kind": "sample",
  "line": "राममेव तु धर्मज्ञमुपगम्य विनीतवत्",
  "before": "जग्मतुर्येन तौ गङ्गां सीतया सह राघवौ",
  "after": "किमहं करवाणीति सूतः प्राञ्जलिरब्रवीत्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "02.046.45a",
  "kind": "sample",
  "line": "इमे चापि हया वीर यदि ते वनवासिनः",
  "before": "राजधानी महेन्द्रस्य यथा दुष्कृतकर्मणा",
  "after": "परिचर्यां करिष्यन्ति प्राप्स्यन्ति परमां गतिम्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "02.046.77a",
  "kind": "sample",
  "line": "पृष्ठतोऽहं गमिष्यामि त्वां च सीतां च पालयन्",
  "before": "अग्रतो गच्छ सौमित्रे सीता त्वामनुगच्छतु",
  "after": "अद्य दुःखं तु वैदेही वनवासस्य वेत्स्यति",
  "note": "ordinary line, no flag"
 },
 {
  "id": "02.051.11b",
  "kind": "sample",
  "line": "न द्रक्ष्यामः पुनर्जातु धार्मिकं राममन्तरा",
  "before": "दानयज्ञविवाहेषु समाजेषु महत्सु च",
  "after": "किं समर्थं जनस्यास्य किं प्रियं किं सुखावहम्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "02.053.26b",
  "kind": "sample",
  "line": "वचनमनुनिशम्य तस्य देवी॑ भयमगमत्पुनरेव राममाता",
  "before": "इति विलपति पार्थिवे प्रनष्टे॑ करुणतरं द्विगुणं च रामहेतोः",
  "after": "ततो भूतोपसृष्टेव वेपमाना पुनः पुनः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "02.055.11a",
  "kind": "sample",
  "line": "एवं कनीयसा भ्रात्रा भुक्तं राज्यं विशां पते",
  "before": "जह्याद्राज्यं च कोशं च भरतेनोपभोक्ष्यते",
  "after": "भ्राता ज्येष्ठा वरिष्ठाश्च किमर्थं नावमंस्यते",
  "note": "ordinary line, no flag"
 },
 {
  "id": "02.056.2a",
  "kind": "sample",
  "line": "तस्य चिन्तयमानस्य प्रत्यभात्कर्म दुष्कृतम्",
  "before": "श्रावितः परुषं वाक्यं चिन्तयामास दुःखितः",
  "after": "यदनेन कृतं पूर्वमज्ञानाच्छब्दवेधिना",
  "note": "ordinary line, no flag"
 },
 {
  "id": "02.060.12a",
  "kind": "sample",
  "line": "तैलद्रोण्यामथामात्याः संवेश्य जगतीपतिम्",
  "before": "व्यपनिन्युः सुदुःखार्तां कौसल्यां व्यावहारिकाः",
  "after": "राज्ञः सर्वाण्यथादिष्टाश्चक्रुः कर्माण्यनन्तरम्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "02.065.11a",
  "kind": "sample",
  "line": "हस्तिपृष्ठकमासाद्य कुटिकामत्यवर्तत",
  "before": "अन्या नदीश्च विविधाः पार्वतीयैस्तुरङ्गमैः",
  "after": "ततार च नरव्याघ्रो लौहित्ये स कपीवतीम्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "02.069.5a",
  "kind": "sample",
  "line": "ततः शत्रुघ्न भरतौ कौसल्यां प्रेक्ष्य दुःखितौ",
  "before": "प्रतस्थे भरतो यत्र कौसल्याया निवेशनम्",
  "after": "पर्यष्वजेतां दुःखार्तां पतितां नष्टचेतनाम्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "02.072.18b",
  "kind": "sample",
  "line": "कैकेयीमभिनिर्भर्त्स्य बभाषे परुषं वचः",
  "before": "स बली बलवत्क्रोधाद्गृहीत्वा पुरुषर्षभः",
  "after": "तैर्वाक्यैः परुषैर्दुःखैः कैकेयी भृशदुःखिता",
  "note": "ordinary line, no flag"
 },
 {
  "id": "02.076.8a",
  "kind": "sample",
  "line": "तच्छ्रुत्वा भरतो वाक्यं शोकेनाभिपरिप्लुतः",
  "before": "कोट्यापरान्ताः सामुद्रा रत्नान्यभिहरन्तु ते",
  "after": "जगाम मनसा रामं धर्मज्ञो धर्मकाङ्क्षया",
  "note": "ordinary line, no flag"
 },
 {
  "id": "02.077.15a",
  "kind": "sample",
  "line": "रजकास्तुन्नवायाश्च ग्रामघोषमहत्तराः",
  "before": "स्नापकाच्छादका वैद्या धूपकाः शौण्डिकास्तथा",
  "after": "शैलूषाश्च सह स्त्रीभिर्यान्ति कैवर्तकास्तथा",
  "note": "ordinary line, no flag"
 },
 {
  "id": "02.079.21a",
  "kind": "sample",
  "line": "गुहेन सार्धं भरतः समागतो॑ महानुभावः सजनः समाहितः",
  "before": "आक्रान्तो दुःखशैलेन महता कैकयीसुतः",
  "after": "सुदुर्मनास्तं भरतं तदा पुनर्॑ गुहः समाश्वासयदग्रजं प्रति",
  "note": "ordinary line, no flag"
 },
 {
  "id": "02.081.11b",
  "kind": "sample",
  "line": "कौसल्यां परिसान्त्व्येदं गुहं वचनमब्रवीत्",
  "before": "स मुहूर्तं समाश्वस्य रुदन्नेव महायशाः",
  "after": "भ्राता मे क्वावसद्रात्रिं क्व सीता क्व च लक्ष्मणः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "02.083.3a",
  "kind": "sample",
  "line": "जागर्मि नाहं स्वपिमि तथैवार्यं विचिन्तयन्",
  "before": "शीघ्रमानय भद्रं ते तारयिष्यति वाहिनीम्",
  "after": "इत्येवमब्रवीद्भ्रात्रा शत्रुघ्नोऽपि प्रचोदितः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "02.083.12a",
  "kind": "sample",
  "line": "ततः स्वस्तिकविज्ञेयां पाण्डुकम्बलसंवृताम्",
  "before": "शोभमानाः पताकिन्यो युक्तवाताः सुसंहताः",
  "after": "सनन्दिघोषां कल्याणीं गुहो नावमुपाहरत्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "02.083.19b",
  "kind": "sample",
  "line": "तरन्तः स्म प्रकाशन्ते सध्वजा इव पर्वताः",
  "before": "सवैजयन्तास्तु गजा गजारोहैः प्रचोदिताः",
  "after": "नावश्चारुरुहुस्त्वन्ये प्लवैस्तेरुस्तथापरे",
  "note": "ordinary line, no flag"
 },
 {
  "id": "02.090.10a",
  "kind": "sample",
  "line": "अग्निं संशमयत्वार्यः सीता च भजतां गुहाम्",
  "before": "शशंस सेनां रामाय वचनं चेदमब्रवीत्",
  "after": "सज्यं कुरुष्व चापं च शरांश्च कवचं तथा",
  "note": "ordinary line, no flag"
 },
 {
  "id": "02.100.8a",
  "kind": "sample",
  "line": "समृद्धायामयोध्यायामात्मानमभिषेचय",
  "before": "आस्थातुं कापथं दुःखं विषमं बहुकण्टकम्",
  "after": "एकवेणीधरा हि त्वां नगरी सम्प्रतीक्षते",
  "note": "ordinary line, no flag"
 },
 {
  "id": "02.105.15b",
  "kind": "sample",
  "line": "भरद्वाजः शुभतरं मुनिर्वाक्यमुदाहरत्",
  "before": "एतच्छ्रुत्वा शुभं वाक्यं भरतस्य महात्मनः",
  "after": "नैतच्चित्रं नरव्याघ्र शीलवृत्तवतां वर",
  "note": "ordinary line, no flag"
 },
 {
  "id": "02.106.8a",
  "kind": "sample",
  "line": "त्यक्तां यज्ञायुधैः सर्वैरभिरूपैश्च याजकैः",
  "before": "प्रशान्तमारुतोद्धूतां जलोर्मिमिव निःस्वनाम्",
  "after": "सुत्याकाले विनिर्वृत्ते वेदिं गतरवामिव",
  "note": "ordinary line, no flag"
 },
 {
  "id": "02.108.18a",
  "kind": "sample",
  "line": "तैर्दुरात्मभिराविष्टानाश्रमान् प्रजिहासवः",
  "before": "कलशांश्च प्रमृद्नन्ति हवने समुपस्थिते",
  "after": "गमनायान्यदेशस्य चोदयन्त्यृषयोऽद्य माम्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "03.003.10a",
  "kind": "sample",
  "line": "ततः सज्यं धनुः कृत्वा रामः सुनिशिताञ्शरान्",
  "before": "रणे सम्प्राप्स्यसे तिष्ठ न मे जीवन् गमिष्यसि",
  "after": "सुशीघ्रमभिसन्धाय राक्षसं निजघान ह",
  "note": "ordinary line, no flag"
 },
 {
  "id": "03.005.20a",
  "kind": "sample",
  "line": "भवतामर्थसिद्ध्यर्थमागतोऽहं यदृच्छया",
  "before": "नैवमर्हथ मां वक्तुमाज्ञाप्योऽहं तपस्विनम्",
  "after": "तस्य मेऽयं वने वासो भविष्यति महाफलः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "03.006.14b",
  "kind": "sample",
  "line": "आख्यातः शरभङ्गेन गौतमेन महात्मना",
  "before": "भवान् सर्वत्र कुशलः सर्वभूतहिते रतः",
  "after": "एवमुक्तस्तु रामेण महर्षिर्लोकविश्रुतः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "03.008.29a",
  "kind": "sample",
  "line": "स्त्रीचापलादेतदुदाहृतं मे॑ धर्मं च वक्तुं तव कः समर्थः",
  "before": "सर्वं हि विदितं तुभ्यं त्रैलोक्यमपि तत्त्वतः",
  "after": "विचार्य बुद्ध्या तु सहानुजेन॑ यद्रोचते तत्कुरु माचिरेण",
  "note": "ordinary line, no flag"
 },
 {
  "id": "03.013.10b",
  "kind": "sample",
  "line": "षष्टिर्दुहितरो राम यशस्विन्यो महायशः",
  "before": "प्रजापतेस्तु दक्षस्य बभूवुरिति नः श्रुतम्",
  "after": "कश्यपः प्रतिजग्राह तासामष्टौ सुमध्यमाः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "03.016.25b",
  "kind": "sample",
  "line": "इदं वचनमारेभे वक्तुं वाक्यविशारदः",
  "before": "इत्येवमुक्तः काकुत्स्थः प्रहस्य मदिरेक्षणाम्",
  "after": "तां तु शूर्पणखां रामः कामपाशावपाशिताम्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "03.017.14a",
  "kind": "sample",
  "line": "सा रामं पर्णशालायामुपविष्टं परन्तपम्",
  "before": "मन्यते तद्वचः सत्यं परिहासाविचक्षणा",
  "after": "सीतया सह दुर्धर्षमब्रवीत्काममोहिता",
  "note": "ordinary line, no flag"
 },
 {
  "id": "03.019.18b",
  "kind": "sample",
  "line": "जग्राह परमक्रुद्धश्चतुर्दश शिलाशितान्",
  "before": "ततः पश्चान्महातेजा नाराचान् सूर्यसन्निभान्",
  "after": "गृहीत्वा धनुरायम्य लक्ष्यानुद्दिश्य राक्षसान्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "03.019.24a",
  "kind": "sample",
  "line": "सा नदन्ती महानादं जवाच्छूर्पणखा पुनः",
  "before": "परित्रस्ता पुनस्तत्र व्यसृजद्भैरवं रवम्",
  "after": "उपगम्य खरं सा तु किं चित्संशुष्क शोणिता",
  "note": "ordinary line, no flag"
 },
 {
  "id": "03.029.15a",
  "kind": "sample",
  "line": "कालपाशपरिक्षिप्ता भवन्ति पुरुषा हि ये",
  "before": "वाच्यावाच्यं ततो हि त्वं मृत्युवश्यो न बुध्यसे",
  "after": "कार्याकार्यं न जानन्ति ते निरस्तषडिन्द्रियाः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "03.030.2a",
  "kind": "sample",
  "line": "दूषणं च खरं चैव हतं त्रिशिरसं रणे",
  "before": "हतान्येकेन रामेण रक्षसां भीमकर्मणाम्",
  "after": "दृष्ट्वा पुनर्महानादं ननाद जलदोपमा",
  "note": "ordinary line, no flag"
 },
 {
  "id": "03.030.15a",
  "kind": "sample",
  "line": "वनं चैत्ररथं दिव्यं नलिनीं नन्दनं वनम्",
  "before": "विमानं पुष्पकं तस्य कामगं वै जहार यः",
  "after": "विनाशयति यः क्रोधाद्देवोद्यानानि वीर्यवान्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "03.033.18a",
  "kind": "sample",
  "line": "हंसक्रौञ्चप्लवाकीर्णं सारसैः सम्प्रणादितम्",
  "before": "देवदानवसङ्घैश्च चरितं त्वमृताशिभिः",
  "after": "वैदूर्यप्रस्तरं रम्यं स्निग्धं सागरतेजसा",
  "note": "ordinary line, no flag"
 },
 {
  "id": "03.037.20a",
  "kind": "sample",
  "line": "इदं वचो बन्धुहितार्थिना मया॑ यथोच्यमानं यदि नाभिपत्स्यसे",
  "before": "न ते रामकथा कार्या यदि मां द्रष्टुमिच्छसि",
  "after": "सबान्धवस्त्यक्ष्यसि जीवितं रणे॑ हतोऽद्य रामेण शरैरजिह्मगैः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "03.041.21a",
  "kind": "sample",
  "line": "तेन काञ्चनरोण्णा तु मणिप्रवरशृङ्गिणा",
  "before": "वपुषा त्वस्य सत्त्वस्य विस्मयो जनितो मम",
  "after": "तरुणादित्यवर्णेन नक्षत्रपथवर्चसा",
  "note": "ordinary line, no flag"
 },
 {
  "id": "03.041.47b",
  "kind": "sample",
  "line": "अप्रमत्तेन ते भाव्यमाश्रमस्थेन सीतया",
  "before": "त्वचा प्रधानया ह्येष मृगोऽद्य न भविष्यति",
  "after": "यावत्पृषतमेकेन सायकेन निहन्म्यहम्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "03.044.29a",
  "kind": "sample",
  "line": "मदान्वितानां घोराणां कुञ्जराणां तरस्विनाम्",
  "before": "ऋक्षास्तरक्षवः कङ्काः कथं तेभ्यो न बिभ्यसे",
  "after": "कथमेका महारण्ये न बिभेषि वनानने",
  "note": "ordinary line, no flag"
 },
 {
  "id": "03.045.6b",
  "kind": "sample",
  "line": "कैकेयी नाम भर्तारं ममार्या याचते वरम्",
  "before": "तस्मिन् सम्भ्रियमाणे तु राघवस्याभिषेचने",
  "after": "प्रतिगृह्य तु कैकेयी श्वशुरं सुकृतेन मे",
  "note": "ordinary line, no flag"
 }
]