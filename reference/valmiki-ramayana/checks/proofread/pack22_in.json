[
 {
  "id": "03.045.33a",
  "kind": "sample",
  "line": "पादपान् काञ्चनान्नूनं बहून् पश्यसि मन्दभाक्",
  "before": "नाहं शक्या त्वया स्प्रष्टुमादित्यस्य प्रभा यथा",
  "after": "राघवस्य प्रियां भार्यां यस्त्वमिच्छसि रावण",
  "note": "ordinary line, no flag"
 },
 {
  "id": "03.050.32a",
  "kind": "sample",
  "line": "उत्पात वाताभिहता नानाद्विज गणायुताः",
  "before": "वैदेह्या निपतन् भाति गङ्गेव गगनाच्च्युता",
  "after": "मा भैरिति विधूताग्रा व्याजह्रुरिव पादपाः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "03.051.24b",
  "kind": "sample",
  "line": "भयशोकसमाविष्टा करुणं विललाप ह",
  "before": "एतच्चान्यच्च परुषं वैदेही रावणाङ्कगा",
  "after": "तथा भृशार्तां बहु चैव भाषिणीं॑ विललाप पूर्वं करुणं च भामिनीम्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "03.051.25b",
  "kind": "sample",
  "line": "जहार पापस्तरुणीं विवेष्टतीं॑ नृपात्मजामागतगात्रवेपथुम्",
  "before": "तथा भृशार्तां बहु चैव भाषिणीं॑ विललाप पूर्वं करुणं च भामिनीम्",
  "after": "ह्रियमाणा तु वैदेही कं चिन्नाथमपश्यती",
  "note": "ordinary line, no flag"
 },
 {
  "id": "03.052.6a",
  "kind": "sample",
  "line": "तां जहार सुसंहृष्टो रावणो मृत्युमात्मनः",
  "before": "जगाम रुदतीं गृह्य मैथिलीं राक्षसेश्वरः",
  "after": "उत्सङ्गेनैव भुजगीं तीक्ष्णदंष्ट्रां महाविषाम्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "03.053.16b",
  "kind": "sample",
  "line": "जीवितं च विशालाक्षि त्वं मे प्राणैर्गरीयसी",
  "before": "यदिदं राज्यतन्त्रं मे त्वयि सर्वं प्रतिष्ठितम्",
  "after": "बहूनां स्त्रीसहस्राणां मम योऽसौ परिग्रहः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "03.058.33b",
  "kind": "sample",
  "line": "क्व चिन्मत्त इवाभाति कान्तान् वेषणतत्परः",
  "before": "क्व चिदुद्भ्रमते वेगात्क्व चिद्विभ्रमते बलात्",
  "after": "स वनानि नदीः शैलान् गिरिप्रस्रवणानि च",
  "note": "ordinary line, no flag"
 },
 {
  "id": "03.060.2b",
  "kind": "sample",
  "line": "नदीं गोदावरीं रम्यां जगाम लघुविक्रमः",
  "before": "एवमुक्तस्तु रामेण लक्ष्मणः पुनरेव हि",
  "after": "तां लक्ष्मणस्तीर्थवतीं विचित्वा राममब्रवीत्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "03.061.12a",
  "kind": "sample",
  "line": "येन राजन् हृता सीता तमन्वेषितुमर्हसि",
  "before": "नालं ते विप्रियं कर्तुं दीक्षितस्येव साधवः",
  "after": "मद्द्वितीयो धनुष्पाणिः सहायैः परमर्षिभिः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "03.064.7a",
  "kind": "sample",
  "line": "कथंवीर्यः कथंरूपः किङ्कर्मा स च राक्षसः",
  "before": "सीतया कानि चोक्तानि तस्मिन् काले द्विजोत्तम",
  "after": "क्व चास्य भवनं तात ब्रूहि मे परिपृच्छतः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "03.071.18b",
  "kind": "sample",
  "line": "नीलां कुवलयोद्धातैर्बहुवर्णां कुथामिव",
  "before": "पद्मैः सौगन्धिकैस्ताम्रां शुक्लां कुमुदमण्डलैः",
  "after": "अरविन्दोत्पलवतीं पद्मसौगन्धिकायुताम्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.006.7a",
  "kind": "sample",
  "line": "अनुमानात्तु जानामि मैथिली सा न संशयः",
  "before": "त्यज शोकं महाबाहो तां कान्तामानयामि ते",
  "after": "ह्रियमाणा मया दृष्टा रक्षसा क्रूरकर्मणा",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.009.21a",
  "kind": "sample",
  "line": "राज्यं प्रशासतस्तस्य न्यायतो मम राघव",
  "before": "ततोऽहं तैः समागम्य समेतैरभिषेचितः",
  "after": "आजगाम रिपुं हत्वा वाली तमसुरोत्तमम्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.010.15b",
  "kind": "sample",
  "line": "निहतश्च मया तत्र सोऽसुरो बन्धुभिः सह",
  "before": "स तु दृष्टो मया शत्रुरनिर्वेदाद्भयावहः",
  "after": "तस्यास्यात्तु प्रवृत्तेन रुधिरौघेण तद्बिलम्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.019.25b",
  "kind": "sample",
  "line": "अवष्टभ्यावतिष्ठन्तं ददर्श धनुरूर्जितम्",
  "before": "नागहेतोः सुपर्णेन चैत्यमुन्मथितं यथा",
  "after": "रामं रामानुजं चैव भर्तुश्चैवानुजं शुभा",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.024.9a",
  "kind": "sample",
  "line": "इतः स्वां प्रकृतिं वाली गतः प्राप्तः क्रियाफलम्",
  "before": "धर्मश्चार्थश्च कामश्च कालक्रमसमाहिताः",
  "after": "धर्मार्थकामसंयोगैः पवित्रं प्लवगेश्वर",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.024.17b",
  "kind": "sample",
  "line": "त्वरा गुणवती युक्ता ह्यस्मिन् काले विशेषतः",
  "before": "त्वं तार शिबिकां शीघ्रमादायागच्छ सम्भ्रमात्",
  "after": "सज्जीभवन्तु प्लवगाः शिबिकावाहनोचिताः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.025.35a",
  "kind": "sample",
  "line": "रामस्य तु वचः कुर्वन् सुग्रीवो हरिपुङ्गवः",
  "before": "प्रचुक्रुशुर्महात्मानो हृष्टास्तत्र सहस्रशः",
  "after": "अङ्गदं सम्परिष्वज्य यौवराज्येऽभिषेचयत्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.025.36b",
  "kind": "sample",
  "line": "साधु साध्विति सुग्रीवं महात्मानोऽभ्यपूजयन्",
  "before": "अङ्गदे चाभिषिक्ते तु सानुक्रोशाः प्लवङ्गमाः",
  "after": "हृष्टपुष्टजनाकीर्णा पताकाध्वजशोभिता",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.027.8b",
  "kind": "sample",
  "line": "शक्यमञ्जलिभिः पातुं वाताः केतकिगन्धिनः",
  "before": "मेघोदरविनिर्मुक्ताः कह्लारसुखशीतलाः",
  "after": "एष फुल्लार्जुनः शैलः केतकैरधिवासितः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.027.24a",
  "kind": "sample",
  "line": "वहन्ति वर्षन्ति नदन्ति भान्ति॑ ध्यायन्ति नृत्यन्ति समाश्वसन्ति",
  "before": "जाता वृषा गोषु समानकामा॑ जाता मही सस्यवनाभिरामा",
  "after": "नद्यो घना मत्तगजा वनान्ताः॑ प्रियाविनीहाः शिखिनः प्लवङ्गाः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.030.9a",
  "kind": "sample",
  "line": "सोऽ ग्रजेनानुशिष्टार्थो यथावत्पुरुषर्षभः",
  "before": "वक्तुमर्हसि सुग्रीवं व्यतीतं कालपर्यये",
  "after": "प्रविवेश पुरीं वीरो लक्ष्मणः परवीरहा",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.034.6b",
  "kind": "sample",
  "line": "प्राप्तकालं न जानीते विश्वामित्रो यथा मुनिः",
  "before": "सुदुःखं शायितः पूर्वं प्राप्येदं सुखमुत्तमम्",
  "after": "घृताच्यां किल संसक्तो दशवर्षाणि लक्ष्मण",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.039.33a",
  "kind": "sample",
  "line": "तं कालमेघप्रतिमं महोरगनिषेवितम्",
  "before": "ब्रह्मणा समनुज्ञाता दीर्घकालं बुभुक्षिताः",
  "after": "अभिगम्य महानादं तीर्थेनैव महोदधिम्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.039.56a",
  "kind": "sample",
  "line": "शैलस्य तस्य कुञ्जेषु कन्दरेषु वनेषु च",
  "before": "यस्मिंस्तेजश्च चक्षुश्च सर्वप्रानभृतामपि",
  "after": "रावणः सह वैदेह्या मार्गितव्यस्ततस्ततः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.040.41a",
  "kind": "sample",
  "line": "तत्र गन्धर्वपतयः पञ्चसूर्यसमप्रभाः",
  "before": "रोहिता नाम गन्धर्वा घोरा रक्षन्ति तद्वनम्",
  "after": "शैलूषो ग्रामणीर्भिक्षुः शुभ्रो बभ्रुस्तथैव च",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.041.39b",
  "kind": "sample",
  "line": "निकेतं पाशहस्तस्य वरुणस्य महात्मनः",
  "before": "शोभितं तरुभिश्चित्रैर्नानापक्षिसमाकुलैः",
  "after": "अन्तरा मेरुमस्तं च तालो दशशिरा महान्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.042.40b",
  "kind": "sample",
  "line": "तरुणादित्यसदृशैर्भान्ति तत्र जलाशयाः",
  "before": "रक्तोत्पलवनैश्चात्र मण्डिताश्च हिरण्मयैः",
  "after": "महार्हमणिपत्रैश्च काञ्चनप्रभ केसरैः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.046.8a",
  "kind": "sample",
  "line": "उत्तरां तु दिशं सर्वां विचित्य स महाकपिः",
  "before": "अदृष्ट्वा विनतः सीतामाजगाम महाबलः",
  "after": "आगतः सह सैन्येन वीरः शतबलिस्तदा",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.046.14b",
  "kind": "sample",
  "line": "दिशं तु यामेव गता तु सीता॑ तामास्थितो वायुसुतो हनूमान्",
  "before": "उदारसत्त्वाभिजनो महात्मा॑ स मैथिलीं द्रक्ष्यति वानरेन्द्रः",
  "after": "सहताराङ्गदाभ्यां तु गत्वा स हनुमान् कपिः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.048.12a",
  "kind": "sample",
  "line": "सदृशं खलु वो वाक्यमङ्गदो यदुवाच ह",
  "before": "उवाचाव्यक्तया वाचा पिपासा श्रमखिन्नया",
  "after": "हितं चैवानुकूलं च क्रियतामस्य भाषितम्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.050.14a",
  "kind": "sample",
  "line": "तमप्सरसि हेमायां सक्तं दानवपुङ्गवम्",
  "before": "उवास सुखितः कालं कं चिदस्मिन्महावने",
  "after": "विक्रम्यैवाशनिं गृह्य जघानेशः पुरन्दरः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.051.4a",
  "kind": "sample",
  "line": "राजा सर्वस्य लोकस्य महेन्द्रवरुणोपमः",
  "before": "आर्जवेन यथातत्त्वमाख्यातुमुपचक्रमे",
  "after": "रामो दाशरथिः श्रीमान् प्रविष्टो दण्डकावनम्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.055.3a",
  "kind": "sample",
  "line": "कन्दरादभिनिष्क्रम्य स विन्ध्यस्य महागिरेः",
  "before": "भ्राता जटायुषः श्रीमान् प्रख्यातबलपौरुषः",
  "after": "उपविष्टान् हरीन् दृष्ट्वा हृष्टात्मा गिरमब्रवीत्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.063.4a",
  "kind": "sample",
  "line": "दक्षिणस्य समुद्रस्य समासाद्योत्तरां दिशम्",
  "before": "कृत्स्नं लोकस्य महतः प्रतिबिम्बमिव स्थितम्",
  "after": "सन्निवेशं ततश्चक्रुः सहिता वानरोत्तमाः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.063.20a",
  "kind": "sample",
  "line": "यदि कश्चित्समर्थो वः सागरप्लवने हरिः",
  "before": "अभिगच्छेम संहृष्टाः सुग्रीवं च महाबलम्",
  "after": "स ददात्विह नः शीघ्रं पुण्यामभयदक्षिणाम्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "05.004.24b",
  "kind": "sample",
  "line": "बभूव दुःखाभिहतश्चिरस्य॑ प्लवङ्गमो मन्द इवाचिरस्य",
  "before": "सीतामपश्यन्मनुजेश्वरस्य॑ रामस्य पत्नीं वदतां वरस्य",
  "after": "स निकामं विनामेषु विचरन् कामरूपधृक्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "05.015.28a",
  "kind": "sample",
  "line": "रक्षितां स्वेन शीलेन सीतामसितलोचनाम्",
  "before": "तां देवीं दीनवदनामदीनां भर्तृतेजसा",
  "after": "तां दृष्ट्वा हनुमान् सीतां मृगशावनिभेक्षणाम्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "05.016.5b",
  "kind": "sample",
  "line": "न स तं राक्षसः कामं शशाकात्मनि गूहितुम्",
  "before": "भृशं नियुक्तस्तस्यां च मदनेन मदोत्कटः",
  "after": "स सर्वाभरणैर्युक्तो बिभ्रच्छ्रियमनुत्तमाम्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "05.016.7b",
  "kind": "sample",
  "line": "सदामदैश्च विहगैर्विचित्रां परमाद्भुताम्",
  "before": "वृतां पुष्करिणीभिश्च नानापुष्पोपशोभिताम्",
  "after": "ईहामृगैश्च विविधैश्वृतां दृष्टिमनोहरैः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "05.017.7b",
  "kind": "sample",
  "line": "दुःखस्यान्तमपश्यन्तीं रामां राममनुव्रताम्",
  "before": "शुष्यन्तीं रुदतीमेकां ध्यानशोकपरायणाम्",
  "after": "वेष्टमानामथाविष्टां पन्नगेन्द्रवधूमिव",
  "note": "ordinary line, no flag"
 },
 {
  "id": "05.019.13a",
  "kind": "sample",
  "line": "एवं त्वां पापकर्माणं वक्ष्यन्ति निकृता जनाः",
  "before": "अभिनन्दन्ति भूतानि विनाशे पापकर्मणः",
  "after": "दिष्ट्यैतद्व्यसनं प्राप्तो रौद्र इत्येव हर्षिताः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "05.019.27b",
  "kind": "sample",
  "line": "शक्यं सन्दर्शने स्थातुं शुना शार्दूलयोरिव",
  "before": "न हि गन्धमुपाघ्राय रामलक्ष्मणयोस्त्वया",
  "after": "तस्य ते विग्रहे ताभ्यां युगग्रहणमस्थिरम्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "05.020.11b",
  "kind": "sample",
  "line": "सीतामाश्वासयामासुस्तर्जितां तेन रक्षसा",
  "before": "ओष्ठप्रकारैरपरा नेत्रवक्त्रैस्तथापराः",
  "after": "ताभिराश्वासिता सीता रावणं राक्षसाधिपम्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "05.021.10a",
  "kind": "sample",
  "line": "येन देवास्त्रयस्त्रिंशद्देवराजश्च निर्जितः",
  "before": "विवृत्य नयने कोपान्मार्जारसदृशेक्षणा",
  "after": "तस्य त्वं राक्षसेन्द्रस्य भार्या भवितुमर्हसि",
  "note": "ordinary line, no flag"
 },
 {
  "id": "05.026.10a",
  "kind": "sample",
  "line": "नूनं स कालो मृगरूपधारी॑ मामल्पभाग्यां लुलुभे तदानीम्",
  "before": "नूनं विशस्तौ मम कारणात्तौ॑ सिंहर्षभौ द्वाविव वैद्युतेन",
  "after": "यत्रार्यपुत्रं विससर्ज मूढा॑ रामानुजं लक्ष्मणपूर्वकं च",
  "note": "ordinary line, no flag"
 },
 {
  "id": "05.031.24a",
  "kind": "sample",
  "line": "प्रागेव तु महाभागः सौमित्रिर्मित्रनन्दनः",
  "before": "न हि मे तेन हीनाया वासः स्वर्गेऽपि रोचते",
  "after": "पूर्वजस्यानुयात्रार्थे द्रुमचीरैरलङ्कृतः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "05.032.31b",
  "kind": "sample",
  "line": "रोषप्रमुक्तैरिषुभिर्ज्वलद्भिरिव पावकैः",
  "before": "नचिराद्रावणं सङ्ख्ये यो वधिष्यति वीर्यवान्",
  "after": "तेनाहं प्रेषितो दूतस्त्वत्सकाशमिहागतः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "05.033.47a",
  "kind": "sample",
  "line": "सहितौ रामसुग्रीवावुभावकुरुतां तदा",
  "before": "समित्रबान्धवं हत्वा रावणं जनकात्मजे",
  "after": "समयं वालिनं हन्तुं तव चान्वेषणं तथा",
  "note": "ordinary line, no flag"
 },
 {
  "id": "05.033.61a",
  "kind": "sample",
  "line": "जटायोस्तु वधं श्रुत्वा दुःखितः सोऽरुणात्मजः",
  "before": "रक्षसा भीमरूपेण त्वामुद्दिश्य यथातथम्",
  "after": "त्वामाह स वरारोहे वसन्तीं रावणालये",
  "note": "ordinary line, no flag"
 },
 {
  "id": "05.033.77b",
  "kind": "sample",
  "line": "नेत्राभ्यां वक्रपक्ष्माभ्यां मुमोचानन्दजं जलम्",
  "before": "अतुलं च गता हर्षं प्रहर्षेण तु जानकी",
  "after": "चारु तच्चाननं तस्यास्ताम्रशुक्लायतेक्षणम्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "05.034.32b",
  "kind": "sample",
  "line": "श्रुत्वैव तु वचो मह्यं क्षिप्रमेष्यति राघवः",
  "before": "न त्वामिहस्थां जानीते रामः कमललोचनः",
  "after": "चमूं प्रकर्षन्महतीं हर्यृष्कगणसङ्कुलाम्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "05.036.33a",
  "kind": "sample",
  "line": "मत्कृते काकमात्रेऽपि ब्रह्मास्त्रं समुदीरितम्",
  "before": "त्वया वीर विसृष्टस्तु प्रतिपेदे स्वमालयम्",
  "after": "कस्माद्यो मां हरत्त्वत्तः क्षमसे तं महीपते",
  "note": "ordinary line, no flag"
 },
 {
  "id": "05.036.35c",
  "kind": "sample",
  "line": "भर्तारं ससमुद्राया धरण्या वासवोपमम्",
  "before": "अपारपारमक्षोभ्यं गाम्भीर्यात्सागरोपमम्",
  "after": "एवमस्त्रविदां श्रेष्ठः सत्त्ववान् बलवानपि",
  "note": "ordinary line, no flag"
 },
 {
  "id": "05.040.23a",
  "kind": "sample",
  "line": "आत्मनः सदृशाञ्शूरान् किङ्करान्नाम राक्षसान्",
  "before": "हुतागिरिव जज्वाल कोपसंवर्तितेक्षणः",
  "after": "व्यादिदेश महातेजा निग्रहार्थं हनूमतः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "05.040.35a",
  "kind": "sample",
  "line": "ततस्तस्माद्भयान्मुक्ताः कति चित्तत्र राक्षसाः",
  "before": "युद्धाकाङ्क्षी पुनर्वीरस्तोरणं समुपस्थितः",
  "after": "निहतान् किङ्करान् सर्वान् रावणाय न्यवेदयन्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "05.041.6a",
  "kind": "sample",
  "line": "जयत्यतिबलो रामो लक्ष्मणश्च महाबलः",
  "before": "पेतुर्विहङ्गा गगनादुच्चैश्चेदमघोषयत्",
  "after": "राजा जयति सुग्रीवो राघवेणाभिपालितः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "05.042.7b",
  "kind": "sample",
  "line": "बाह्वोर्विव्याध नाराचैर्दशभिस्तं कपीश्वरम्",
  "before": "अर्धचन्द्रेण वदने शिरस्येकेन कर्णिना",
  "after": "तस्य तच्छुशुभे ताम्रं शरेणाभिहतं मुखम्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "05.045.14a",
  "kind": "sample",
  "line": "ततः स वीरः सुमुखान् पतत्रिणः॑ सुवर्णपुङ्खान् सविषानिवोरगान्",
  "before": "कपेः कुमारस्य च वीक्ष्य संयुगं॑ ननाद च द्यौरुदधिश्च चुक्षुभे",
  "after": "समाधिसंयोगविमोक्षतत्त्वविच्॑ छरानथ त्रीन् कपिमूर्ध्न्यपातयत्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "05.045.22b",
  "kind": "sample",
  "line": "रथी रथश्रेष्ठतमः किरञ्शरैः॑ पयोधरः शैलमिवाश्मवृष्टिभिः",
  "before": "समुत्पतन्तं समभिद्रवद्बली॑ स राक्षसानां प्रवरः प्रतापवान्",
  "after": "स ताञ्शरांस्तस्य विमोक्षयन् कपिश्॑ चचार वीरः पथि वायुसेविते",
  "note": "ordinary line, no flag"
 }
]