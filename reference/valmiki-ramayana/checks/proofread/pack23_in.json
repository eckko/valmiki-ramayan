[
 {
  "id": "05.046.20a",
  "kind": "sample",
  "line": "तस्मिंस्ततः संयति जातहर्षे॑ रणाय निर्गच्छति बाणपाणौ",
  "before": "हनूमन्तमभिप्रेत्य जगाम रणपण्डितः",
  "after": "दिशश्च सर्वाः कलुषा बभूवुर्॑ मृगाश्च रौद्रा बहुधा विनेदुः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "05.047.13a",
  "kind": "sample",
  "line": "मन्त्रिभिर्मन्त्रतत्त्वज्ञैरन्यैश्च शुभबुद्धिभिः",
  "before": "कृत्स्नैः परिवृतं लोकं चतुर्भिरिव सागरैः",
  "after": "अन्वास्यमानं सचिवैः सुरैरिव सुरेश्वरम्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "05.049.1b",
  "kind": "sample",
  "line": "वाक्यमर्थवदव्यग्रस्तमुवाच दशाननम्",
  "before": "तं समीक्ष्य महासत्त्वं सत्त्ववान् हरिसत्तमः",
  "after": "अहं सुग्रीवसन्देशादिह प्राप्तस्तवालयम्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "05.050.4a",
  "kind": "sample",
  "line": "निश्चितार्थस्ततः साम्नापूज्य शत्रुजिदग्रजम्",
  "before": "विदित्वा चिन्तयामास कार्यं कार्यविधौ स्थितः",
  "after": "उवाच हितमत्यर्थं वाक्यं वाक्यविशारदः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "05.050.16b",
  "kind": "sample",
  "line": "मनस्विनः शस्त्रभृतां वरिष्ठाः॑ कोट्यग्रशस्ते सुभृताश्च योधाः",
  "before": "हिताश्च शूराश्च समाहिताश्च॑ कुलेषु जाताश्च महागुणेषु",
  "after": "तदेकदेशेन बलस्य तावत्॑ के चित्तवादेशकृतोऽपयान्तु",
  "note": "ordinary line, no flag"
 },
 {
  "id": "05.053.17b",
  "kind": "sample",
  "line": "पूरमप्युपलब्धानि साक्षात्पुनरचिन्तयत्",
  "before": "इति चिन्तयतस्तस्य निमित्तान्युपपेदिरे",
  "after": "अथ वा चारुसर्वाङ्गी रक्षिता स्वेन तेजसा",
  "note": "ordinary line, no flag"
 },
 {
  "id": "05.056.67a",
  "kind": "sample",
  "line": "उक्तश्च मधुरां वाणीं तया स मदनार्दितः",
  "before": "वरा मन्दोदरी नाम तया स प्रतिषेधितः",
  "after": "सीतया तव किं कार्यं महेन्द्रसमविक्रम",
  "note": "ordinary line, no flag"
 },
 {
  "id": "05.057.12a",
  "kind": "sample",
  "line": "एकवेणीधरा दीना भर्तृचिन्तापरायणा",
  "before": "राक्षसीभिर्विरूपाभिर्दृष्टा हि प्रमदा वने",
  "after": "अधःशय्या विवर्णाङ्गी पद्मिनीव हिमागमे",
  "note": "ordinary line, no flag"
 },
 {
  "id": "05.060.6a",
  "kind": "sample",
  "line": "ते प्रहृष्टा मधुवनं पालानाक्रम्य वीर्यतः",
  "before": "जग्मुर्मधुवनं यत्र नदीवेग इव द्रुतम्",
  "after": "अतिसर्गाच्च पटवो दृष्ट्वा श्रुत्वा च मैथिलीम्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "05.065.31b",
  "kind": "sample",
  "line": "शिरसा सम्प्रणम्यैनामहमागमने त्वरे",
  "before": "प्रतिगृह्य मणिं दिव्यं तव हेतो रघूत्तम",
  "after": "गमने च कृतोत्साहमवेक्ष्य वरवर्णिनी",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.003.17b",
  "kind": "sample",
  "line": "काञ्चनैर्बहुभिः स्तम्भैर्वेदिकाभिश्च शोभितः",
  "before": "एकस्त्वकम्प्यो बलवान् सङ्क्रमः सुमहादृढः",
  "after": "स्वयं प्रकृतिसम्पन्नो युयुत्सू राम रावणः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.004.21a",
  "kind": "sample",
  "line": "शतैः शतसहस्रैश्च कोटीभिरयुतैरपि",
  "before": "जगाम रामो धर्मात्मा ससैन्यो दक्षिणां दिशम्",
  "after": "वारणाभिश्च हरिभिर्ययौ परिवृतस्तदा",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.004.23a",
  "kind": "sample",
  "line": "हृष्टाः प्रमुदिताः सर्वे सुग्रीवेणाभिपालिताः",
  "before": "तं यान्तमनुयाति स्म महती हरिवाहिनी",
  "after": "आप्लवन्तः प्लवन्तश्च गर्जन्तश्च प्लवङ्गमाः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.004.57a",
  "kind": "sample",
  "line": "चम्पकांस्तिलकांश्चूतानशोकान् सिन्दुवारकान्",
  "before": "पश्यन्नपि ययौ रामः सह्यस्य मलयस्य च",
  "after": "करवीरांश्च तिमिशान् भञ्जन्ति स्म प्लवङ्गमाः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.009.15b",
  "kind": "sample",
  "line": "आहृता सा परित्याज्या कलहार्थे कृते न किम्",
  "before": "एतन्निमित्तं वैदेही भयं नः सुमहद्भवेत्",
  "after": "न नः क्षमं वीर्यवता तेन धर्मानुवर्तिना",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.009.22a",
  "kind": "sample",
  "line": "त्यजस्व कोपं सुखधर्मनाशनं॑ भजस्व धर्मं रतिकीर्तिवर्धनम्",
  "before": "सृजत्यमोघान् विशिखान् वधाय ते॑ प्रदीयतां दाशरथाय मैथिली",
  "after": "प्रसीद जीवेम सपुत्रबान्धवाः॑ प्रदीयतां दाशरथाय मैथिली",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.014.5b",
  "kind": "sample",
  "line": "असामर्थ्यं फलन्त्येते निर्गुणेषु सतां गुणाः",
  "before": "प्रशमश्च क्षमा चैव आर्जवं प्रियवादिता",
  "after": "आत्मप्रशंसिनं दुष्टं धृष्टं विपरिधावकम्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.015.13b",
  "kind": "sample",
  "line": "काममद्यैव बध्नन्तु सेतुं वानरपुङ्गवाः",
  "before": "न चाप्यहमनुक्तो वै प्रब्रूयामात्मनो गुणान्",
  "after": "ततो निसृष्टरामेण सर्वतो हरियूथपाः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.018.4b",
  "kind": "sample",
  "line": "द्रुमानुद्यम्य सहिता लङ्कारोहणतत्पराः",
  "before": "यं पृष्ठतोऽनुगच्छन्ति शतशोऽथ सहस्रशः",
  "after": "एष कोटीसहस्रेण वानराणां महौजसाम्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.021.1a",
  "kind": "sample",
  "line": "ततस्तमक्षोभ्य बलं लङ्काधिपतये चराः",
  "before": "गिरेः सुवेलस्य समीपवासिनं॑ न्यवेदयन् भीमबलं महाबलाः",
  "after": "सुवेले राघवं शैले निविष्टं प्रत्यवेदयन्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.021.15a",
  "kind": "sample",
  "line": "यदि मां प्रतियुध्येरन् देवगन्धर्वदानवाः",
  "before": "शार्दूलस्य महद्वाक्यमथोवाच स रावणः",
  "after": "नैव सीतां प्रदास्यामि सर्वलोकभयादपि",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.022.6b",
  "kind": "sample",
  "line": "मायाविदं महामायः प्राविशद्यत्र मैथिली",
  "before": "ततो राक्षसमाहूय विद्युज्जिह्वं महाबलम्",
  "after": "विद्युज्जिह्वं च मायाज्ञमब्रवीद्राक्षसाधिपः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.022.13a",
  "kind": "sample",
  "line": "सान्त्व्यमाना मया भद्रे यमुपाश्रित्य वल्गसे",
  "before": "इदं च वचनं धृष्टमुवाच जनकात्मजाम्",
  "after": "खर हन्ता स ते भर्ता राघवः समरे हतः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.022.38a",
  "kind": "sample",
  "line": "तमब्रवीत्ततो राजा रावणो राक्षसं स्थितम्",
  "before": "प्रणामं शिरसा कृत्वा रावणस्याग्रतः स्थितः",
  "after": "विद्युज्जिह्वं महाजिह्वं समीपपरिवर्तिनम्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.023.25a",
  "kind": "sample",
  "line": "प्रव्रज्यामुपपन्नानां त्रयाणामेकमागतम्",
  "before": "अग्निहोत्रेण संस्कारं केन त्वं तु न लप्स्यसे",
  "after": "परिप्रक्ष्यति कौसल्या लक्ष्मणं शोकलालसा",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.024.32a",
  "kind": "sample",
  "line": "अचिरान्मोक्ष्यते सीते देवि ते जघनं गताम्",
  "before": "समागम्य परिष्वक्ता तस्योरसि महोरसः",
  "after": "धृतामेतां बहून्मासान् वेणीं रामो महाबलः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.026.30c",
  "kind": "sample",
  "line": "एतान्यन्यानि दुष्टानि निमित्तान्युत्पतन्ति च",
  "before": "कालो गृहाणि सर्वेषां काले कालेऽन्ववेक्षते",
  "after": "विष्णुं मन्यामहे रामं मानुषं देहमास्थितम्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.035.16a",
  "kind": "sample",
  "line": "बद्धौ तु शरबन्धेन तावुभौ रणमूर्धनि",
  "before": "रामलक्ष्मणयोर्वीरो ननाद च मुहुर्मुहुः",
  "after": "निमेषान्तरमात्रेण न शेकतुरुदीक्षितुम्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.035.20b",
  "kind": "sample",
  "line": "नानिर्भिन्नं न चास्तब्धमा कराग्रादजिह्मगैः",
  "before": "न ह्यविद्धं तयोर्गात्रं बभूवाङ्गुलमन्तरम्",
  "after": "तौ तु क्रूरेण निहतौ रक्षसा कामरूपिणा",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.036.2a",
  "kind": "sample",
  "line": "वृष्ट्वेवोपरते देवे कृतकर्मणि राक्षसे",
  "before": "ददृशुः सन्ततौ बाणैर्भ्रातरौ रामलक्ष्मणौ",
  "after": "आजगामाथ तं देशं ससुग्रीवो विभीषणः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.036.3a",
  "kind": "sample",
  "line": "नीलद्विविदमैन्दाश्च सुषेणसुमुखाङ्गदाः",
  "before": "आजगामाथ तं देशं ससुग्रीवो विभीषणः",
  "after": "तूर्णं हनुमता सार्धमन्वशोचन्त राघवौ",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.036.17b",
  "kind": "sample",
  "line": "यूथपानपि तान् सर्वांस्ताडयामास रावणिः",
  "before": "एवमुक्त्वा तु तान् सर्वान् राक्षसान् परिपार्श्वगान्",
  "after": "तानर्दयित्वा बाणौघैस्त्रासयित्वा च वानरान्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.037.6b",
  "kind": "sample",
  "line": "ता उवाच ततो हृष्टो राक्षसी राक्षसेश्वरः",
  "before": "राक्षस्यस्त्रिजटा चापि शासनात्तमुपस्थिताः",
  "after": "हताविन्द्रजिताख्यात वैदेह्या रामलक्ष्मणौ",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.038.15b",
  "kind": "sample",
  "line": "तीर्त्वा सागरमक्षोभ्यं भ्रातरौ गोष्पदे हतौ",
  "before": "शोधयित्वा जनस्थानं प्रवृत्तिमुपलभ्य च",
  "after": "ननु वारुणमाग्नेयमैन्द्रं वायव्यमेव च",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.041.18a",
  "kind": "sample",
  "line": "एवमुक्त्वा तु सङ्क्रुद्धो निश्वसन्नुरगो यथा",
  "before": "आदत्तं यैस्तु सङ्ग्रामे रिपूणां मम जीवितम्",
  "after": "अब्रवीद्रक्षसां मध्ये धूम्राक्षं नाम राकसं",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.043.13a",
  "kind": "sample",
  "line": "सर्वे ह्यतिबलाः शूराः सर्वे पर्वतसन्निभाः",
  "before": "रामरावणयोरर्थे समभित्यक्तजीविनाम्",
  "after": "हरयो राक्षसाश्चैव परस्परजिघंसवः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.044.6b",
  "kind": "sample",
  "line": "हरीनभ्यहनत्क्रोधाच्छरजालैरकम्पनः",
  "before": "ततः प्रजविताश्वेन रथेन रथिनां वरः",
  "after": "न स्थातुं वानराः शेकुः किं पुनर्योद्धुमाहवे",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.045.22b",
  "kind": "sample",
  "line": "सङ्ग्रामसज्जाः संहृष्टा धारयन् राक्षसास्तदा",
  "before": "स्रजश्च विविधाकारा जगृहुस्त्वभिमन्त्रिताः",
  "after": "सधनुष्काः कवचिनो वेगादाप्लुत्य राक्षसाः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.050.12a",
  "kind": "sample",
  "line": "अद्य ते सुमहान् कालः शयानस्य महाबल",
  "before": "ईषत्तु परिवृत्ताभ्यां नेत्राभ्यां वाक्यमब्रवीत्",
  "after": "सुखितस्त्वं न जानीषे मम रामकृतं भयम्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.051.37a",
  "kind": "sample",
  "line": "अद्य पर्वतसङ्काशं ससूर्यमिव तोयदम्",
  "before": "शत्रोर्युधि विनाशेन करोम्यस्रप्रमार्जनम्",
  "after": "विकीर्णं पश्य समरे सुग्रीवं प्लवगेश्वरम्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.052.12a",
  "kind": "sample",
  "line": "येन पूर्वं जनस्थाने बहवोऽतिबला हताः",
  "before": "तत्राप्यनुपपन्नं ते वक्ष्यामि यदसाधु च",
  "after": "राक्षसा राघवं तं त्वं कथमेको जयिष्यसि",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.052.12b",
  "kind": "sample",
  "line": "राक्षसा राघवं तं त्वं कथमेको जयिष्यसि",
  "before": "येन पूर्वं जनस्थाने बहवोऽतिबला हताः",
  "after": "ये पुरा निर्जितास्तेन जनस्थाने महौजसः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.055.41a",
  "kind": "sample",
  "line": "तद्वाक्यं हरिराजस्य सत्त्वधैर्यसमन्वितम्",
  "before": "सहस्वैकं निपातं मे पर्वतस्यास्य राक्षस",
  "after": "श्रुत्वा राक्षसशार्दूलः कुम्भकर्णोऽब्रवीद्वचः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.055.46b",
  "kind": "sample",
  "line": "क्षिप्रं समुत्पत्य निगृह्य दोर्भ्यां॑ बभञ्ज वेगेन सुतोऽनिलस्य",
  "before": "तत्कुम्भकर्णस्य भुजप्रविद्धं॑ शूलं शितं काञ्चनदामजुष्टम्",
  "after": "कृतं भारसहस्रस्य शूलं कालायसं महत्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.055.48a",
  "kind": "sample",
  "line": "स तत्तदा भग्नमवेक्ष्य शूलं॑ चुकोप रक्षोऽधिपतिर्महात्मा",
  "before": "बभञ्ज जनौमारोप्य प्रहृष्टः प्लवगर्षभः",
  "after": "उत्पाट्य लङ्कामलयात्स शृङ्गं॑ जघान सुग्रीवमुपेत्य तेन",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.055.50a",
  "kind": "sample",
  "line": "तमभ्युपेत्याद्भुतघोरवीर्यं॑ स कुम्भकर्णो युधि वानरेन्द्रम्",
  "before": "तं प्रेक्ष्य भूमौ पतितं विसञ्ज्ञं॑ नेदुः प्रहृष्टा युधि यातुधानाः",
  "after": "जहार सुग्रीवमभिप्रगृह्य॑ यथानिलो मेघमतिप्रचण्डः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.057.67a",
  "kind": "sample",
  "line": "दिक्षु सर्वासु बलवान् विचचार नरान्तकः",
  "before": "तावत्प्रासहताः पेतुर्वज्रकृत्ता इवाचलाः",
  "after": "प्रमृद्नन् सर्वतो युद्धे प्रावृट्काले यथानिलः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.057.72b",
  "kind": "sample",
  "line": "तेऽस्वस्था वानरश्रेष्ठाः सुग्रीवमुपतस्थिरे",
  "before": "ये तु पूर्वं महात्मानः कुम्भकर्णेन पातिताः",
  "after": "विप्रेक्षमाणः सुग्रीवो ददर्श हरिवाहिनीम्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.059.37b",
  "kind": "sample",
  "line": "अभिपेतुर्महात्मानो ये प्रधानाः प्लवङ्गमाः",
  "before": "तं भीमवपुषं दृष्ट्वा रथस्थं रथिनां वरम्",
  "after": "कुमुदो द्विविदो मैन्दो नीलः शरभ एव च",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.059.53a",
  "kind": "sample",
  "line": "अथ वा त्वं प्रतिष्टब्धो न निवर्तितुमिच्छसि",
  "before": "न्यस्य चापं निवर्तस्व मा प्राणाञ्जहि मद्गतः",
  "after": "तिष्ठ प्राणान् परित्यज्य गमिष्यसि यमक्षयम्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.061.30b",
  "kind": "sample",
  "line": "कैलासशिखरं चापि द्रक्ष्यस्यरिनिषूदन",
  "before": "ततः काञ्चनमत्युग्रमृषभं पर्वतोत्तमम्",
  "after": "तयोः शिखरयोर्मध्ये प्रदीप्तमतुलप्रभम्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.061.65a",
  "kind": "sample",
  "line": "तं वानराः प्रेक्ष्य तदा विनेदुः॑ स तानपि प्रेक्ष्य मुदा ननाद",
  "before": "सहस्रधारेण सपावकेन॑ चक्रेण खे विष्णुरिवोद्धृतेन",
  "after": "तेषां समुद्घुष्टरवं निशम्य॑ लङ्कालया भीमतरं विनेदुः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.063.50a",
  "kind": "sample",
  "line": "अर्चिःसहस्रविकचं रविमण्डलसप्रभम्",
  "before": "मुष्टिं संवर्तयामास वज्रकल्पं महाबलः",
  "after": "स मुष्टिं पातयामास कुम्भस्योरसि वीर्यवान्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.070.30a",
  "kind": "sample",
  "line": "मम चेदं मतं तात धर्मोऽयमिति राघव",
  "before": "सर्वमेतद्यथाकामं काकुत्स्थ कुरुते नरः",
  "after": "धर्ममूलं त्वया छिन्नं राज्यमुत्सृजता तदा",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.073.18b",
  "kind": "sample",
  "line": "चकार बहुभिर्वृक्षैर्निःसञ्ज्ञं युधि वानरः",
  "before": "स राक्षसानां तत्सैन्यं कालाग्निरिव निर्दहन्",
  "after": "विध्वंसयन्तं तरसा दृष्ट्वैव पवनात्मजम्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.073.22a",
  "kind": "sample",
  "line": "घोरैः परशुभिश्चैव भिण्डिपालैश्च राक्षसाः",
  "before": "शतशश्च शतघ्नीभिरायसैरपि मुद्गरैः",
  "after": "मुष्टिभिर्वज्रवेगैश्च तलैरशनिसन्निभैः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.074.9a",
  "kind": "sample",
  "line": "तमुवाच महातेजाः पौलस्त्यमपराजितम्",
  "before": "इन्द्रजित्कवची खड्गी सध्वजः प्रत्यदृश्यत",
  "after": "समाह्वये त्वां समरे सम्यग्युद्धं प्रयच्छ मे",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.077.23b",
  "kind": "sample",
  "line": "शरौघानभिवर्षन्तौ जघ्नतुस्तौ परस्परम्",
  "before": "तौ प्रयुद्धौ तदा वीरौ मृधे लक्ष्मणराक्षसौ",
  "after": "अभीक्ष्णमन्तर्दधतुः शरजालैर्महाबलौ",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.078.36a",
  "kind": "sample",
  "line": "चुक्रुशुस्ते ततः सर्वे वानराः सविभीषणाः",
  "before": "कवची सशिरस्त्राणो विध्वस्तः सशरासनः",
  "after": "हृष्यन्तो निहते तस्मिन् देवा वृत्रवधे यथा",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.079.10b",
  "kind": "sample",
  "line": "रामः सुषेणं मुदितः समाभाष्येदमब्रवीत्",
  "before": "स तं भ्रातरमाश्वास्य पारिष्वज्य च राघवः",
  "after": "सशल्योऽयं महाप्राज्ञः सौमित्रिर्मित्रवत्सलः",
  "note": "ordinary line, no flag"
 }
]