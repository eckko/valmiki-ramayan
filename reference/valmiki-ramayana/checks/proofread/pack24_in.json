[
 {
  "id": "06.079.16a",
  "kind": "sample",
  "line": "ततः प्रकृतिमापन्नो हृतशल्यो गतव्यथः",
  "before": "सर्ववानरमुख्यानां चिकित्सां स तदाकरोत्",
  "after": "सौमित्रिर्मुदितस्तत्र क्षणेन विगतज्वरः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.082.33a",
  "kind": "sample",
  "line": "अद्य प्रभृति लोकांस्त्रीन् सर्वे दानवराक्षसाः",
  "before": "उवाच देवताः सर्वा इदं तुष्टो महद्वचः",
  "after": "भयेन प्रावृता नित्यं विचरिष्यन्ति शाश्वतम्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.084.33b",
  "kind": "sample",
  "line": "बलं समस्तं कपिराक्षसानाम्॑ उन्मत्तगङ्गाप्रतिमं बभूव",
  "before": "विनाशितं प्रेक्ष्य विरूपनेत्रं॑ महाबलं तं हरिपार्थिवेन",
  "after": "हन्यमाने बले तूर्णमन्योन्यं ते महामृधे",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.087.45a",
  "kind": "sample",
  "line": "ग्रहनक्षत्रवर्णांश्च महोल्का मुखसंस्थितान्",
  "before": "चन्द्रार्धचन्द्रवक्त्रांश्च धूमकेतुमुखानपि",
  "after": "विद्युज्जिह्वोपमांश्चान्यान् ससर्ज निशिताञ्शरान्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.088.15a",
  "kind": "sample",
  "line": "सारथेश्चापि बाणेन शिरो ज्वलितकुण्डलम्",
  "before": "ध्वजं मनुष्यशीर्षं तु तस्य चिच्छेद नैकधा",
  "after": "जहार लक्ष्मणः श्रीमान्नैरृतस्य महाबलः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.091.29a",
  "kind": "sample",
  "line": "स शरैर्भिन्नसर्वाङ्गो गात्रप्रस्रुत शोणितः",
  "before": "राघवः परमायत्तो ललाटे पत्रिभिस्त्रिभिः",
  "after": "राक्षसेन्द्रः समूहस्थः फुल्लाशोक इवाबभौ",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.094.20a",
  "kind": "sample",
  "line": "ताम्राः पीताः सिताः श्वेताः पतिताः सूर्यरश्मयः",
  "before": "रक्षसां च प्रहरतां गृहीता इव बाहवः",
  "after": "दृश्यन्ते रावणस्याङ्गे पर्वतस्येव धातवः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.099.30a",
  "kind": "sample",
  "line": "एतस्मिन्नन्तरे रामो विभीषणमुवाच ह",
  "before": "त्वयि पञ्चत्वमापन्ने फलते शोकपीडितम्",
  "after": "संस्कारः क्रियतां भ्रातुः स्त्रियश्चैता निवर्तय",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.100.8b",
  "kind": "sample",
  "line": "सौमित्रिं सत्त्वसम्पन्नं लक्ष्मणं दीप्ततेजसं",
  "before": "अब्रवीच्च तदा रामः समीपपरिवर्तिनम्",
  "after": "विभीषणमिमं सौम्य लङ्कायामभिषेचय",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.101.9a",
  "kind": "sample",
  "line": "मया ह्यलब्धनिद्रेण धृतेन तव निर्जये",
  "before": "रावणः स हतः शत्रुर्लङ्का चेयं वशे स्थिता",
  "after": "प्रतिज्ञैषा विनिस्तीर्णा बद्ध्वा सेतुं महोदधौ",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.102.35a",
  "kind": "sample",
  "line": "विस्मयाच्च प्रहर्षाच्च स्नेहाच्च परिदेवता",
  "before": "रुरोदासाद्य भर्तारमार्यपुत्रेति भाषिणी",
  "after": "उदैक्षत मुखं भर्तुः सौम्यं सौम्यतरानना",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.107.25b",
  "kind": "sample",
  "line": "स शापः कैकयीं घोरः सपुत्रां न स्पृशेत्प्रभो",
  "before": "सपुत्रां त्वां त्यजामीति यदुक्ता कैकयी त्वया",
  "after": "स तथेति महाराजो राममुक्त्वा कृताञ्जलिम्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.109.13a",
  "kind": "sample",
  "line": "प्रीतियुक्तस्तु मे राम ससैन्यः ससुहृद्गणः",
  "before": "अर्चितः सर्वकामैस्त्वं ततो राम गमिष्यसि",
  "after": "सत्क्रियां विहितां तावद्गृहाण त्वं मयोद्यताम्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.109.21a",
  "kind": "sample",
  "line": "अनुजानीहि मां सौम्य पूजितोऽस्मि विभीषण",
  "before": "कृतकार्यस्य मे वासः कथं चिदिह सम्मतः",
  "after": "मन्युर्न खलु कर्तव्यस्त्वरितस्त्वानुमानये",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.110.1a",
  "kind": "sample",
  "line": "उपस्थितं तु तं दृष्ट्वा पुष्पकं पुष्पभूषितम्",
  "before": "निवेदयित्वा रामाय तस्थौ तत्र विभीषणः",
  "after": "अविदूरे स्थितं रामं प्रत्युवाच विभीषणः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "07.001.10a",
  "kind": "sample",
  "line": "दृष्ट्वा प्राप्तान्मुनींस्तांस्तु प्रत्युत्थाय कृताञ्जलिः",
  "before": "तदोवाच नृपो द्वाःस्थं प्रवेशय यथासुखम्",
  "after": "रामोऽभिवाद्य प्रयत आसनान्यादिदेश ह",
  "note": "ordinary line, no flag"
 },
 {
  "id": "07.003.16b",
  "kind": "sample",
  "line": "यमेन्द्रवरुणानां हि पदं यत्तव चेप्सितम्",
  "before": "अहं हि लोकपालानां चतुर्थं स्रष्टुमुद्यतः",
  "after": "तत्कृतं गच्छ धर्मज्ञ धनेशत्वमवाप्नुहि",
  "note": "ordinary line, no flag"
 },
 {
  "id": "07.010.13a",
  "kind": "sample",
  "line": "पितामहस्तु सुप्रीतः सार्धं देवैरुपस्थितः",
  "before": "छेत्तुकामः स धर्मात्मा प्राप्तश्चात्र पितामहः",
  "after": "वत्स वत्स दशग्रीव प्रीतोऽस्मीत्यभ्यभाषत",
  "note": "ordinary line, no flag"
 },
 {
  "id": "07.010.20b",
  "kind": "sample",
  "line": "शृणु चापि वचो भूयः प्रीतस्येह शुभं मम",
  "before": "भविष्यत्येवमेवैतत्तव राक्षसपुङ्गव",
  "after": "हुतानि यानि शीर्षाणि पूर्वमग्नौ त्वयानघ",
  "note": "ordinary line, no flag"
 },
 {
  "id": "07.010.31a",
  "kind": "sample",
  "line": "कुम्भकर्णाय तु वरं प्रयच्छन्तमरिन्दम",
  "before": "नाधर्मे जायते बुद्धिरमरत्वं ददामि ते",
  "after": "प्रजापतिं सुराः सर्वे वाक्यं प्राञ्जलयोऽब्रुवन्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "07.014.6a",
  "kind": "sample",
  "line": "ततो बलस्य सङ्क्षोभः सागरस्येव वर्धतः",
  "before": "अनुज्ञाता ययुश्चैव युद्धाय धनदेन ते",
  "after": "अभून्नैरृतराजस्य गिरिं सञ्चालयन्निव",
  "note": "ordinary line, no flag"
 },
 {
  "id": "07.017.16b",
  "kind": "sample",
  "line": "आश्रितां विद्धि मां धर्मं नारायणपतीच्छया",
  "before": "एतत्ते सर्वमाख्यातं मया राक्षसपुङ्गव",
  "after": "विज्ञातस्त्वं हि मे राजन् गच्छ पौलस्त्यनन्दन",
  "note": "ordinary line, no flag"
 },
 {
  "id": "07.026.32b",
  "kind": "sample",
  "line": "नलकूबरमासाद्य पादयोर्निपपात ह",
  "before": "सा वेपमाना लज्जन्ती भीता करकृताञ्जलिः",
  "after": "तदवस्थां च तां दृष्ट्वा महात्मा नलकूबरः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "07.031.38a",
  "kind": "sample",
  "line": "रावणं प्राञ्जलिं यान्तमन्वयुः सप्तराक्षसाः",
  "before": "नर्मदा सलिलात्तस्मादुत्ततार स रावणः",
  "after": "यत्र यत्र स याति स्म रावणो राक्षसाधिपः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "07.032.1a",
  "kind": "sample",
  "line": "नर्मदा पुलिने यत्र राक्षसेन्द्रः स रावणः",
  "before": "समर्चयित्वा स निशाचरो जगौ॑ प्रसार्य हस्तान् प्रणनर्त चायतान्",
  "after": "पुष्पोपहारं कुरुते तस्माद्देशाददूरतः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "07.034.10a",
  "kind": "sample",
  "line": "स तु तारं विनिर्भर्त्स्य रावणो राक्षसेश्वरः",
  "before": "वालिनं द्रक्ष्यसे तत्र भूमिष्ठमिव भास्करम्",
  "after": "पुष्पकं तत्समारुह्य प्रययौ दक्षिणार्णवम्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "07.034.38b",
  "kind": "sample",
  "line": "त्वया सह चिरं सख्यं सुस्निग्धं पावकाग्रतः",
  "before": "सोऽहं दृष्टबलस्तुभ्यमिच्छामि हरिपुङ्गव",
  "after": "दाराः पुत्राः पुरं राष्ट्रं भोगाच्छादनभोजनम्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "07.035.38a",
  "kind": "sample",
  "line": "इन्द्रः करीन्द्रमारुह्य राहुं कृत्वा पुरःसरम्",
  "before": "शृङ्गारकारिणं प्रांषुं स्वर्णघण्टाट्टहासिनम्",
  "after": "प्रायाद्यत्राभवत्सूर्यः सहानेन हनूमता",
  "note": "ordinary line, no flag"
 },
 {
  "id": "07.036.22a",
  "kind": "sample",
  "line": "ततः सुराणां तु वरैर्दृष्ट्वा ह्येनमकङ्कृतम्",
  "before": "तेषां सङ्ग्रामकाले तु अवध्योऽयं भविष्यति",
  "after": "चतुर्मुखस्तुष्टमुखो वायुमाह जगद्गुरुः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "07.039.11a",
  "kind": "sample",
  "line": "अहं च नित्यशो राजन् सुग्रीवसहितस्त्वया",
  "before": "बुद्धिमन्तो हि राजानो ध्रुवमश्नन्ति मेदिनीम्",
  "after": "स्मर्तव्यः परया प्रीत्या गच्छ त्वं विगतज्वरः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "07.040.15b",
  "kind": "sample",
  "line": "हर्षश्चाभ्यधिको राजञ्जनस्य पुरवासिनः",
  "before": "पुत्रान्नार्यः प्रसूयन्ते वपुष्मन्तश्च मानवाः",
  "after": "काले च वासवो वर्षं पातयत्यमृतोपमम्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "07.053.20a",
  "kind": "sample",
  "line": "स प्रभावेन शूलस्य दौरात्म्येनात्मनस्तथा",
  "before": "शूलं निवेश्य लवणे वरं तस्मै न्यवेदयत्",
  "after": "सन्तापयति लोकांस्त्रीन् विशेषेण तु तापसान्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "07.057.18b",
  "kind": "sample",
  "line": "अश्वमेधं महायज्ञं तं वसिष्ठोऽभ्यपालयत्",
  "before": "राजापि यजते यज्ञं तस्याश्रमसमीपतः",
  "after": "तत्र यज्ञो महानासीद्बहुवर्ष गणायुतान्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "07.061.27a",
  "kind": "sample",
  "line": "एष वै कैटभस्यार्थे मधुनश्च महाशरः",
  "before": "शरस्तेजोमयो वत्सा येन वै भयमागतम्",
  "after": "सृष्टो महात्मना तेन वधार्थं दैत्ययोस्तयोः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "07.062.8a",
  "kind": "sample",
  "line": "सा सेन शीघ्रमागच्छच्छ्रुत्वा शत्रुघ्नशासनम्",
  "before": "शत्रुघ्नोऽपि महातेजास्तां सेनां समुपानयत्",
  "after": "निवेशनं च शत्रुघ्नः शासनेन समारभत्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "07.069.25b",
  "kind": "sample",
  "line": "मानुषः पूर्वको देहो राजर्षेः स ननाश ह",
  "before": "मया प्रतिगृहीते तु तस्मिन्नाभरणे शुभे",
  "after": "प्रनष्टे तु शरीरेऽसौ राजर्षिः परया मुदा",
  "note": "ordinary line, no flag"
 },
 {
  "id": "07.073.12b",
  "kind": "sample",
  "line": "प्रशाधि राज्यं धर्मेण गतिर्हि जगतो भवान्",
  "before": "गच्छ चारिष्टमव्यग्रः पन्थानमकुतोभयम्",
  "after": "एवमुक्तस्तु मुनिना प्राञ्जलिः प्र्पग्रहो नृपः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "07.074.17b",
  "kind": "sample",
  "line": "व्याहृतं पुरुषव्याघ्र पृथिव्याः परिपालनम्",
  "before": "इदं वचनमक्लीबं त्वया धर्मसमाहितम्",
  "after": "एष तस्मादभिप्रायाद्राजसूयात्क्रतूत्तमान्",
  "note": "ordinary line, no flag"
 },
 {
  "id": "07.076.2a",
  "kind": "sample",
  "line": "राघवेणैवमुक्तस्तु सुमित्रानन्दवर्धनः",
  "before": "वृत्रघातमशेषेण कथयेत्याह लक्ष्मणम्",
  "after": "भूय एव कथां दिव्यां कथयामास लक्ष्मणः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "07.078.8a",
  "kind": "sample",
  "line": "स प्रचक्रे महाबाहुर्मृगयां रुचिरे वने",
  "before": "बुद्ध्या च परमोदारो बाह्लीकानां महायशाः",
  "after": "चैत्रे मनोरमे मासि सभृत्यबलवाहनः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "07.090.7a",
  "kind": "sample",
  "line": "किमाह मतुलो वाक्यं यदर्थं भगवानिह",
  "before": "उपविष्टं महाभागं रामः प्रष्टुं प्रचक्रमे",
  "after": "प्राप्तो वाक्यविदां श्रेष्ठ साक्षादिव बृहस्पतिः",
  "note": "ordinary line, no flag"
 },
 {
  "id": "07.096.2b",
  "kind": "sample",
  "line": "पूर्वनिर्माणबद्धा हि कालस्य गतिरीदृशी",
  "before": "न सन्तापं महाबाहो मदर्थं कर्तुमर्हसि",
