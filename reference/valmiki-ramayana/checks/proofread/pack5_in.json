 },
 {
  "id": "07.031.40b",
  "kind": "typo?",
  "line": "समर्चयित्वा स निशाचरो जगौ॑ प्रसार्य हस्तान् प्रणनर्त चायतान्",
  "before": "ततः सतामार्तिहरं हरं परं॑ वरप्रदं चन्द्रमयूखभूषणम्",
