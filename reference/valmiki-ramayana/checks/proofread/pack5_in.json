 },
 {
  "id": "06.093.26a",
  "kind": "typo?",
  "line": "एवमुक्त्वा ततस्तुष्टो रावणो राक्षसेश्वरः",
  "before": "नाहत्वा समरे शत्रून्निवर्तिष्यति रावणः",
