  "lines_deva": [
   "तौ प्रयाते महावीर्यौ दिव्यं त्रिपथगां नदीम्",
   "ददृशाते ततस्तत्र सरय्वाः सङ्गमे शुभे"
  ],
  "lines_iast": [
