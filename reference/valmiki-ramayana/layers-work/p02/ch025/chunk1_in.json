  "lines_deva": [
   "वनं तु नेतुं न कृता मतिस्तदा॑ बभूव रामेण यदा महात्मना",
   "न तस्य सीता वचनं चकार तत्॑ ततोऽब्रवीद्राममिदं सुदुःखिता"
  ],
  "lines_iast": [
   "vanaṃ tu netuṃ na kṛtā matistadā̭ babhūva rāmeṇa yadā mahātmanā",
   "na tasya sītā vacanaṃ cakāra taṱ tato'bravīdrāmamidaṃ suduḥkhitā"
  ],
