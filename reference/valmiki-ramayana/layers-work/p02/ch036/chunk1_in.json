  "lines_deva": [
   "ततस्त्वयोध्या रहिता महात्मना॑ पुरन्दरेणेव मही सपर्वता",
   "चचाल घोरं भयभारपीडिता॑ सनागयोधाश्वगणा ननाद च"
  ],
  "lines_iast": [
   "tatastvayodhyā rahitā mahātmanā̭ purandareṇeva mahī saparvatā",
   "cacāla ghoraṃ bhayabhārapīḍitā̭ sanāgayodhāśvagaṇā nanāda ca"
  ],
