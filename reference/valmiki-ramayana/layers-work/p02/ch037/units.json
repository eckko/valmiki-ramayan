   "02.037.28b"
  ],
  "lines_deva": [
   "तं राममेवानुविचिन्तयन्तं॑ समीक्ष्य देवी शयने नरेन्द्रम्",
   "उपोपविश्याधिकमार्तरूपा॑ विनिःश्वसन्ती विललाप कृच्छ्रं"
  ],
  "lines_iast": [
   "taṃ rāmamevānuvicintayanta̭ṃ samīkṣya devī śayane narendram",
   "upopaviśyādhikamārtarūpā̭ viniḥśvasantī vilalāpa kṛcchraṃ"
  ],
