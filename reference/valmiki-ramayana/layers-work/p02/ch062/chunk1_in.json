  "lines_deva": [
   "भर्तुः प्रियार्थं कुलरक्षणार्थं॑ भर्तुश्च वंशस्य परिग्रहार्थम्",
   "अहेडमानास्त्वरया स्म दूता॑ रात्र्यां तु ते तत्पुरमेव याताः"
  ],
  "lines_iast": [
   "bhartuḥ priyārthaṃ kularakṣaṇārtha̭ṃ bhartuśca vaṃśasya parigrahārtham",
   "aheḍamānāstvarayā sma dūtā̭ rātryāṃ tu te tatpurameva yātāḥ"
  ],
