  "lines_deva": [
   "नरो यानेन यः स्वप्ने खरयुक्तेन याति हि",
   "अचिरात्तस्य धूमाग्रं चितायां सम्प्रदृश्यते",
   "एतन्निमित्तं दीनोऽहं तन्न वः प्रतिपूजये"
  ],
  "lines_iast": [
   "naro yānena yaḥ svapne kharayuktena yāti hi",
   "acirāttasya dhūmāgraṃ citāyāṃ sampradṛśyate",
   "etannimittaṃ dīno'haṃ tanna vaḥ pratipūjaye"
  ],
