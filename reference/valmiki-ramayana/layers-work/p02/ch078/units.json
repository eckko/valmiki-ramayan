  "lines_deva": [
   "ततो निविष्टां ध्वजिनीं गङ्गामन्वाश्रितां नदीम्",
   "निषादराजो दृष्ट्वैव ज्ञातीन् सन्त्वरितोऽब्रवीत्"
  ],
  "lines_iast": [
