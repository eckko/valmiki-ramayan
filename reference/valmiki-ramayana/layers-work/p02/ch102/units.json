  "lines_deva": [
   "क्रुद्धमाज्ञाय राम तु वसिष्ठः प्रत्युवाच ह",
   "जाबालिरपि जानीते लोकस्यास्य गतागतिम्",
   "निवर्तयितु कामस्तु त्वामेतद्वाक्यमब्रवीत्"
  ],
  "lines_iast": [
   "kruddhamājñāya rāma tu vasiṣṭhaḥ pratyuvāca ha",
   "jābālirapi jānīte lokasyāsya gatāgatim",
   "nivartayitu kāmastu tvāmetadvākyamabravīt"
  ],
  "book_split": [
