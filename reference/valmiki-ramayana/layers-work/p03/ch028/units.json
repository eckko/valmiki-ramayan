   "03.028.27b"
  ],
  "lines_deva": [
   "तामापतन्तीं ज्वलितां मृत्युपाशोपमां गदा",
   "अन्तरिक्षगतां रामश्चिच्छेद बहुधा शरैः"
  ],
  "lines_iast": [
   "tāmāpatantīṃ jvalitāṃ mṛtyupāśopamāṃ gadā",
   "antarikṣagatāṃ rāmaściccheda bahudhā śaraiḥ"
  ],
