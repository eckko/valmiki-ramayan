  "lines_deva": [
   "इत्युक्त्वा परमक्रुद्धस्तां गदां परमाङ्गदाम्",
   "खरश्चिक्षेप रामाय प्रदीप्तामशनिं यथा"
  ],
  "lines_iast": [
   "ityuktvā paramakruddhastāṃ gadāṃ paramāṅgadām",
   "kharaścikṣepa rāmāya pradīptāmaśaniṃ yathā"
  ],
