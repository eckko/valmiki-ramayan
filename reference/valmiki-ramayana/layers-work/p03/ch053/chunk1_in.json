  "lines_deva": [
   "त्रयाणामपि लोकानां न तं पश्यामि शोभने",
   "विक्रमेण नयेद्यस्त्वां मद्बाहुपरिपालिताम्"
  ],
  "lines_iast": [
   "trayāṇāmapi lokānāṃ na taṃ paśyāmi śobhane",
   "vikrameṇa nayedyastvāṃ madbāhuparipālitām"
