  "lines_deva": [
   "स तत्प्रकर्षन् हरिणां बलं महद्॑ बभूव वीरः पवनात्मजः कपि",
   "गताम्बुदे व्योम्नि विशुद्धमण्डलः॑ शशीव नक्षत्रगणोपशोभितः"
  ],
  "lines_iast": [
   "sa tatprakarṣan hariṇāṃ balaṃ mahaḓ babhūva vīraḥ pavanātmajaḥ kapi",
   "gatāmbude vyomni viśuddhamaṇḍala̭ḥ śaśīva nakṣatragaṇopaśobhitaḥ"
  ],
