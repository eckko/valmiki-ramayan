  "lines_deva": [
   "विशेषेण तु सुग्रीवो हनुमत्यर्थमुक्तवान्",
   "स हि तस्मिन् हरिश्रेष्ठे निश्चितार्थोऽर्थसाधने"
  ],
  "lines_iast": [
   "viśeṣeṇa tu sugrīvo hanumatyarthamuktavān",
   "sa hi tasmin hariśreṣṭhe niścitārtho'rthasādhane"
  ],
