  "lines_deva": [
   "गतेषु वानरेन्द्रेषु रामः सुग्रीवमब्रवीत्",
   "कथं भवान् विनाजीते सर्वं वै मण्डलं भुवः"
  ],
  "lines_iast": [
   "gateṣu vānarendreṣu rāmaḥ sugrīvamabravīt",
   "kathaṃ bhavān vinājīte sarvaṃ vai maṇḍalaṃ bhuvaḥ"
  ],
