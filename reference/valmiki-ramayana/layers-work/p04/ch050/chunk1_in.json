  "lines_deva": [
   "महद्धिरण्या विवरं प्रविष्टाः स्म पिपासिताः",
   "इमांस्त्वेवं विधान् भावान् विविधानद्भुतोपमान्",
   "दृष्ट्वा वयं प्रव्यथिताः सम्भ्रान्ता नष्टचेतसः"
  ],
  "lines_iast": [
   "mahaddhiraṇyā vivaraṃ praviṣṭāḥ sma pipāsitāḥ",
   "imāṃstvevaṃ vidhān bhāvān vividhānadbhutopamān",
   "dṛṣṭvā vayaṃ pravyathitāḥ sambhrāntā naṣṭacetasaḥ"
  ],
