  "lines_deva": [
   "निवेशनानां विविधाश्च शालाः॑ प्रधानशङ्खायुधचापशालाः",
   "मनोहराश्चापि पुनर्विशाला॑ ददर्श वेश्माद्रिषु चन्द्रशालाः"
  ],
  "lines_iast": [
   "niveśanānāṃ vividhāśca śālā̭ḥ pradhānaśaṅkhāyudhacāpaśālāḥ",
   "manoharāścāpi punarviśālā̭ dadarśa veśmādriṣu candraśālāḥ"
  ],
