   "सर्वैश्च दोषैः परिवर्जितानि॑ कपिर्ददर्श स्वबलार्जितानि"
  ],
  "lines_iast": [
   "gṛhāṇi nānāvasurājitāni̭ devāsuraiścāpi supūjitāni",
   "sarvaiśca doṣaiḥ parivarjitāni̭ kapirdadarśa svabalārjitāni"
  ],
