   "05.006.1b"
  ],
  "lines_deva": [
   "स वेश्मजालं बलवान् ददर्श॑ व्यासक्तवैदूर्यसुवर्णजालम्",
   "यथा महत्प्रावृषि मेघजालं॑ विद्युत्पिनद्धं सविहङ्गजालम्"
  ],
  "lines_iast": [
   "sa veśmajālaṃ balavān dadarśa̭ vyāsaktavaidūryasuvarṇajālam",
   "yathā mahatprāvṛṣi meghajāla̭ṃ vidyutpinaddhaṃ savihaṅgajālam"
  ],
