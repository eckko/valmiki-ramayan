  "lines_deva": [
   "गजेन्द्रहस्तप्रतिमश्च पीनस्॑ तयोर्द्वयोः संहतयोः सुजातः",
   "प्रस्पन्दमानः पुनरूरुरस्या॑ रामं पुरस्तात्स्थितमाचचक्षे"
  ],
  "lines_iast": [
   "gajendrahastapratimaśca pīnas̭ tayordvayoḥ saṃhatayoḥ sujātaḥ",
   "praspandamānaḥ punarūrurasyā̭ rāmaṃ purastātsthitamācacakṣe"
  ],
