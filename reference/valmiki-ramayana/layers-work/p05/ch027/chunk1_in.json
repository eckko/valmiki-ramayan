  "lines_deva": [
   "शुभं पुनर्हेमसमानवर्णम्॑ ईषद्रजोध्वस्तमिवामलाक्ष्याः",
   "वासः स्थितायाः शिखराग्रदन्त्याः॑ किं चित्परिस्रंसत चारुगात्र्याः"
  ],
  "lines_iast": [
   "śubhaṃ punarhemasamānavarṇam̭ īṣadrajodhvastamivāmalākṣyāḥ",
   "vāsaḥ sthitāyāḥ śikharāgradantyā̭ḥ kiṃ citparisraṃsata cārugātryāḥ"
  ],
