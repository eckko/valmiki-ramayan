  "lines_deva": [
   "एतैर्निमित्तैरपरैश्च सुभ्रूः॑ सम्बोधिता प्रागपि साधुसिद्धैः",
   "वातातपक्लान्तमिव प्रनष्टं॑ वर्षेण बीजं प्रतिसञ्जहर्ष"
  ],
  "lines_iast": [
   "etairnimittairaparaiśca subhrṷ̄ḥ sambodhitā prāgapi sādhusiddhaiḥ",
   "vātātapaklāntamiva pranaṣṭa̭ṃ varṣeṇa bījaṃ pratisañjaharṣa"
  ],
