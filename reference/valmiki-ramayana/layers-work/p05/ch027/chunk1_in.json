   "05.027.1b"
  ],
  "lines_deva": [
   "तथागतां तां व्यथितामनिन्दितां॑ व्यपेतहर्षां परिदीनमानसाम्",
   "शुभां निमित्तानि शुभानि भेजिरे॑ नरं श्रिया जुष्टमिवोपजीविनः"
  ],
  "lines_iast": [
   "tathāgatāṃ tāṃ vyathitāmaninditā̭ṃ vyapetaharṣāṃ paridīnamānasām",
   "śubhāṃ nimittāni śubhāni bhejirḙ naraṃ śriyā juṣṭamivopajīvinaḥ"
  ],
