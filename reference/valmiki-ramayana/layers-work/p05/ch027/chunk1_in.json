  "lines_deva": [
   "तस्याः पुनर्बिम्बफलोपमौष्ठं॑ स्वक्षिभ्रुकेशान्तमरालपक्ष्म",
   "वक्त्रं बभासे सितशुक्लदंष्ट्रं॑ राहोर्मुखाच्चन्द्र इव प्रमुक्तः"
  ],
  "lines_iast": [
   "tasyāḥ punarbimbaphalopamauṣṭha̭ṃ svakṣibhrukeśāntamarālapakṣma",
   "vaktraṃ babhāse sitaśukladaṃṣṭra̭ṃ rāhormukhāccandra iva pramuktaḥ"
  ],
