  "lines_deva": [
   "तस्याः शुभं वाममरालपक्ष्म॑ राजीवृतं कृष्णविशालशुक्लम्",
   "प्रास्पन्दतैकं नयनं सुकेश्या॑ मीनाहतं पद्ममिवाभिताम्रम्"
  ],
  "lines_iast": [
   "tasyāḥ śubhaṃ vāmamarālapakṣma̭ rājīvṛtaṃ kṛṣṇaviśālaśuklam",
   "prāspandataikaṃ nayanaṃ sukeśyā̭ mīnāhataṃ padmamivābhitāmram"
  ],
