  "lines_deva": [
   "भुजश्च चार्वञ्चितपीनवृत्तः॑ परार्ध्य कालागुरुचन्दनार्हः",
   "अनुत्तमेनाध्युषितः प्रियेण॑ चिरेण वामः समवेपताशु"
  ],
  "lines_iast": [
   "bhujaśca cārvañcitapīnavṛtta̭ḥ parārdhya kālāgurucandanārhaḥ",
   "anuttamenādhyuṣitaḥ priyeṇa̭ cireṇa vāmaḥ samavepatāśu"
  ],
