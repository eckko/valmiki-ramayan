  "lines_deva": [
   "सा वीतशोका व्यपनीततन्द्री॑ शान्तज्वरा हर्षविबुद्धसत्त्वा",
   "अशोभतार्या वदनेन शुक्ले॑ शीतान्शुना रात्रिरिवोदितेन"
  ],
  "lines_iast": [
   "sā vītaśokā vyapanītatandrī̭ śāntajvarā harṣavibuddhasattvā",
   "aśobhatāryā vadanena śuklḙ śītānśunā rātririvoditena"
  ],
