  "lines_deva": [
   "सम्प्रधृष्य च दुर्धर्षश्चैत्यप्रासादमुन्नतम्",
   "हनूमान् प्रज्वलंल्लक्ष्म्या पारियात्रोपमोऽभवत्"
  ],
  "lines_iast": [
   "sampradhṛṣya ca durdharṣaścaityaprāsādamunnatam",
   "hanūmān prajvalaṃllakṣmyā pāriyātropamo'bhavat"
  ],
