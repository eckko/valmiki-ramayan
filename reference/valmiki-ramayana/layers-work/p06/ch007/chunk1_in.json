  "lines_deva": [
   "राजन् परिघशक्त्यृष्टिशूलपट्टससङ्कुलम्",
   "सुमहन्नो बलं कस्माद्विषादं भजते भवान्"
  ],
  "lines_iast": [
   "rājan parighaśaktyṛṣṭiśūlapaṭṭasasaṅkulam",
   "sumahanno balaṃ kasmādviṣādaṃ bhajate bhavān"
  ],
