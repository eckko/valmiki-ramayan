  "lines_deva": [
   "ततो हतान् राक्षसपुङ्गवांस्तान्॑ देवान्तकादित्रिशिरोऽतिकायान्",
   "रक्षोगणास्तत्र हतावशिष्टास्॑ ते रावणाय त्वरितं शशंसुः"
  ],
  "lines_iast": [
   "tato hatān rākṣasapuṅgavāṃstāṋ devāntakāditriśiro'tikāyān",
   "rakṣogaṇāstatra hatāvaśiṣṭās̭ te rāvaṇāya tvaritaṃ śaśaṃsuḥ"
  ],
