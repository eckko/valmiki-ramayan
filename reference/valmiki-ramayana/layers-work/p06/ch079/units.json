   "06.079.2b"
  ],
  "lines_deva": [
   "ततः स जाम्बवन्तं च हनूमन्तं च वीर्यवान्",
   "सन्निवर्त्य महातेजास्तांश्च सर्वान् वनौकसः"
  ],
  "lines_iast": [
   "tataḥ sa jāmbavantaṃ ca hanūmantaṃ ca vīryavān",
   "sannivartya mahātejāstāṃśca sarvān vanaukasaḥ"
  ],
