  "lines_deva": [
   "ततस्तु सा लक्ष्मणरामपालिता॑ महाचमूर्हृष्टजना यशस्विनी",
   "श्रिया ज्वलन्ती विरराज सर्वतो॑ निशाप्रणीतेव हि शीतरश्मिना"
  ],
  "lines_iast": [
   "tatastu sā lakṣmaṇarāmapālitā̭ mahācamūrhṛṣṭajanā yaśasvinī",
   "śriyā jvalantī virarāja sarvato̭ niśāpraṇīteva hi śītaraśminā"
