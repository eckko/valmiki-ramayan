  "lines_deva": [
   "परितुष्टोऽस्मि भद्रं ते गुणानां सम्पदा भृशम्",
   "तस्मात्ते विरमाम्यद्य पुत्रमात्मसमं गुणैः",
   "उभयोर्वंशकर्तारं पौलस्त्य इति विश्रुतम्"
  ],
  "lines_iast": [
   "parituṣṭo'smi bhadraṃ te guṇānāṃ sampadā bhṛśam",
   "tasmātte viramāmyadya putramātmasamaṃ guṇaiḥ",
   "ubhayorvaṃśakartāraṃ paulastya iti viśrutam"
  ],
