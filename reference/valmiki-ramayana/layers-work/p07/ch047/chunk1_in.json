  "lines_deva": [
   "सा मुहूर्तमिवासञ्ज्ञा बाष्पव्याकुलितेक्षणा",
   "लक्ष्मणं दीनया वाचा उवाच जनकात्मजा"
  ],
  "lines_iast": [
   "sā muhūrtamivāsañjñā bāṣpavyākulitekṣaṇā",
   "lakṣmaṇaṃ dīnayā vācā uvāca janakātmajā"
  ],
