  ],
  "lines_deva": [
   "सा दुःखभारावनता तपस्विनी॑ यशोधरा नाथमपश्यती सती",
   "रुरोद सा बर्हिणनादिते वने॑ महास्वनं दुःखपरायणा सती"
  ],
  "lines_iast": [
   "sā duḥkhabhārāvanatā tapasvinī̭ yaśodharā nāthamapaśyatī satī",
   "ruroda sā barhiṇanādite vanḙ mahāsvanaṃ duḥkhaparāyaṇā satī"
  ],
