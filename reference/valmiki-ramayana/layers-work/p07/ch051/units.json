  "lines_deva": [
   "तत्र तां रजनीमुष्य गोमत्यां रघुनन्दनः",
   "प्रभाते पुनरुत्थाय लक्ष्मणः प्रययौ तदा"
  ],
  "lines_iast": [
   "tatra tāṃ rajanīmuṣya gomatyāṃ raghunandanaḥ",
   "prabhāte punarutthāya lakṣmaṇaḥ prayayau tadā"
  ],
