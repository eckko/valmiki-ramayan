  "lines_deva": [
   "ततः सुमन्त्रस्त्वागम्य राघवं वाक्यमब्रवीत्",
   "एते निवारिता राजन् द्वारि तिष्ठन्ति तापसाः"
  ],
  "lines_iast": [
   "tataḥ sumantrastvāgamya rāghavaṃ vākyamabravīt",
   "ete nivāritā rājan dvāri tiṣṭhanti tāpasāḥ"
  ],
