  ],
  "lines_deva": [
   "स मानुषमथो मांसं पार्थिवाय न्यवेदयत्",
   "इदं स्वादुहविष्यं च सामिषं चान्नमाहृतम्"
  ],
  "lines_iast": [
   "sa mānuṣamatho māṃsaṃ pārthivāya nyavedayat",
   "idaṃ svāduhaviṣyaṃ ca sāmiṣaṃ cānnamāhṛtam"
  ],
