   "07.058.1b"
  ],
  "lines_deva": [
   "यामेव रात्रिं शत्रुघ्न पर्णशालां समाविशत्",
   "तामेव रात्रिं सीतापि प्रसूता दारकद्वयम्"
  ],
  "lines_iast": [
   "yāmeva rātriṃ śatrughna parṇaśālāṃ samāviśat",
   "tāmeva rātriṃ sītāpi prasūtā dārakadvayam"
  ],
