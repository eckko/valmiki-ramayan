   "07.066.1b"
  ],
  "lines_deva": [
   "नारदस्य तु तद्वाक्यं श्रुत्वामृतमयं यथा",
   "प्रहर्षमतुलं लेभे लक्ष्मणं चेदमब्रवीत्"
  ],
  "lines_iast": [
   "nāradasya tu tadvākyaṃ śrutvāmṛtamayaṃ yathā",
   "praharṣamatulaṃ lebhe lakṣmaṇaṃ cedamabravīt"
  ],
