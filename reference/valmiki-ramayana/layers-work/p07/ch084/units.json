  "lines_deva": [
   "स दृष्ट्वा दिव्यसङ्काशं यज्ञमद्भुतदर्शनम्",
   "एकान्ते ऋषिवाटानां चकार उटजाञ्शुभान्"
  ],
  "lines_iast": [
   "sa dṛṣṭvā divyasaṅkāśaṃ yajñamadbhutadarśanam",
   "ekānte ṛṣivāṭānāṃ cakāra uṭajāñśubhān"
  ],
