  "lines_deva": [
   "वर्तमाने तथाभूते यज्ञे परमकेऽद्भुते",
   "सशिष्य आजगामाशु वाल्मीकिर्मुनिपुङ्गवः"
  ],
  "lines_iast": [
   "vartamāne tathābhūte yajñe paramake'dbhute",
   "saśiṣya ājagāmāśu vālmīkirmunipuṅgavaḥ"
  ],
